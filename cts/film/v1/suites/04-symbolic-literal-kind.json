  "id": "records-and-symbolic-literals",
  "title": "Film v1 Symbolic Literal Kind Mapping",
  "tests": [
    {
      "id": "film-record-012-symbolic-literal-kind",
      "description": "Kind code 18 carries a symbolic literal payload",
      "operation": "decode",
      "input": {
        "film_hex": "4f5f5fff010008001803242e610178"
      },
      "expected": {
        "ok": true,
        "canonical_hex": "4f5f5fff010008001803242e610178",
        "stream": {
          "profile": "aes.complete.v1",
          "profile_explicit": false,
          "projection": null,
          "projection_explicit": false,
          "records": [
            {
              "path": "$.a",
              "kind": "SymbolicLiteral",
              "value": "x"
            }
          ]
        }
      },
      "tags": [
        "kind",
        "symbol",
        "canonical"
      ]
    },
    {
      "id": "film-record-012a-kind-above-v1-range",
      "description": "Codes above the 24 assigned v1 kinds are invalid",
      "operation": "decode",
      "input": {
        "film_hex": "4f5f5fff010008001903242e610178"
      },
      "expected": {
        "ok": false,
        "error": {
          "code": "FILM_INVALID_KIND"
        }
      },
      "tags": [
        "kind",
        "unassigned",
        "failure"
      ]
    },
    {
      "id": "film-record-026-all-assigned-kind-codes",

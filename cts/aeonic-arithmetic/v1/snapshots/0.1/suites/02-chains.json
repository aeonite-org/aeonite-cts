{
  "id": "02-chains",
  "tests": [
    {
      "id": "direct-chain-then-materialize",
      "kind": "chain",
      "steps": [
        {
          "request": {
            "operation": "add",
            "input": {
              "left": {
                "number": {
                  "category": "finiteNumber",
                  "value": "0.1"
                }
              },
              "right": {
                "number": {
                  "category": "finiteNumber",
                  "value": "0.2"
                }
              }
            }
          },
          "expected": {
            "outcome": "value",
            "value": {
              "number": {
                "category": "exactNumber",
                "coefficient": "3",
                "exponent": "-1"
              },
              "history": "none-declared"
            },
            "metadata": {
              "evaluation": "exact-for-operands",
              "effectivePolicy": {
                "profile": "aeonic.operations.arithmetic.exact.v1"
              }
            }
          }
        },
        {
          "request": {
            "operation": "multiply",
            "input": {
              "left": {
                "number": {
                  "category": "exactNumber",
                  "coefficient": "3",
                  "exponent": "-1"
                },
                "history": "none-declared"
              },
              "right": {
                "number": {
                  "category": "finiteNumber",
                  "value": "10"
                }
              }
            }
          },
          "expected": {
            "outcome": "value",
            "value": {
              "number": {
                "category": "exactNumber",
                "coefficient": "3",
                "exponent": "0"
              },
              "history": "none-declared"
            },
            "metadata": {
              "evaluation": "exact-for-operands",
              "effectivePolicy": {
                "profile": "aeonic.operations.arithmetic.exact.v1"
              }
            }
          }
        },
        {
          "request": {
            "operation": "materialize",
            "input": {
              "value": {
                "number": {
                  "category": "exactNumber",
                  "coefficient": "3",
                  "exponent": "0"
                },
                "history": "none-declared"
              },
              "policy": {
                "family": "decimal"
              }
            }
          },
          "expected": {
            "outcome": "value",
            "value": {
              "number": {
                "category": "finiteNumber",
                "value": "3.0"
              },
              "history": "none-declared"
            },
            "metadata": {
              "evaluation": "exact-for-operands",
              "effectivePolicy": {
                "profile": "aeonic.operations.arithmetic.exact.v1",
                "family": "decimal",
                "zeroSign": "positive"
              }
            }
          }
        }
      ],
      "links": [
        {
          "fromStep": 0,
          "toStep": 1,
          "input": "left"
        },
        {
          "fromStep": 1,
          "toStep": 2,
          "input": "value"
        }
      ]
    },
    {
      "id": "history-survives-chain-and-zero",
      "kind": "chain",
      "steps": [
        {
          "request": {
            "operation": "multiply",
            "input": {
              "left": {
                "number": {
                  "category": "finiteNumber",
                  "value": "0.33"
                },
                "history": "approximation-declared"
              },
              "right": {
                "number": {
                  "category": "finiteNumber",
                  "value": "3"
                }
              }
            }
          },
          "expected": {
            "outcome": "value",
            "value": {
              "number": {
                "category": "exactNumber",
                "coefficient": "99",
                "exponent": "-2"
              },
              "history": "approximation-declared"
            },
            "metadata": {
              "evaluation": "exact-for-operands",
              "effectivePolicy": {
                "profile": "aeonic.operations.arithmetic.exact.v1"
              }
            }
          }
        },
        {
          "request": {
            "operation": "subtract",
            "input": {
              "left": {
                "number": {
                  "category": "exactNumber",
                  "coefficient": "99",
                  "exponent": "-2"
                },
                "history": "approximation-declared"
              },
              "right": {
                "number": {
                  "category": "finiteNumber",
                  "value": "0.99"
                }
              }
            }
          },
          "expected": {
            "outcome": "value",
            "value": {
              "number": {
                "category": "exactNumber",
                "coefficient": "0",
                "exponent": "0"
              },
              "history": "approximation-declared"
            },
            "metadata": {
              "evaluation": "exact-for-operands",
              "effectivePolicy": {
                "profile": "aeonic.operations.arithmetic.exact.v1"
              }
            }
          }
        },
        {
          "request": {
            "operation": "materialize",
            "input": {
              "value": {
                "number": {
                  "category": "exactNumber",
                  "coefficient": "0",
                  "exponent": "0"
                },
                "history": "approximation-declared"
              },
              "policy": {
                "family": "exponent",
                "zeroSign": "negative"
              }
            }
          },
          "expected": {
            "outcome": "value",
            "value": {
              "number": {
                "category": "finiteNumber",
                "value": "-0e0"
              },
              "history": "approximation-declared"
            },
            "metadata": {
              "evaluation": "exact-for-operands",
              "effectivePolicy": {
                "profile": "aeonic.operations.arithmetic.exact.v1",
                "family": "exponent",
                "zeroSign": "negative"
              }
            }
          }
        }
      ],
      "links": [
        {
          "fromStep": 0,
          "toStep": 1,
          "input": "left"
        },
        {
          "fromStep": 1,
          "toStep": 2,
          "input": "value"
        }
      ]
    }
  ]
}

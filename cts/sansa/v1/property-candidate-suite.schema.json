{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aeonite:sansa:properties:fixture-candidate:0.2",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object"
    },
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^sansa-properties-[a-z0-9-]+$"
          },
          "description": {
            "type": "string"
          },
          "input": {
            "type": "object",
            "properties": {
              "operation": {
                "enum": [
                  "parse-address",
                  "parse-query",
                  "resolve",
                  "query",
                  "consumer-boundary"
                ]
              },
              "source": {
                "type": "string"
              },
              "ast": {
                "type": "object"
              },
              "generate": {
                "type": "object",
                "properties": {
                  "kind": {
                    "enum": [
                      "payload",
                      "selectors",
                      "canonical"
                    ]
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65537
                  },
                  "form": {
                    "enum": [
                      "text",
                      "ast"
                    ]
                  },
                  "scalar": {
                    "enum": [
                      "x",
                      "\ud83d\ude00"
                    ]
                  },
                  "encoding": {
                    "enum": [
                      "raw",
                      "escaped"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "count",
                  "form"
                ],
                "additionalProperties": false
              },
              "namespace": {
                "const": "properties"
              },
              "options": {
                "type": "object",
                "properties": {
                  "maxPropertyInspections": {},
                  "maxBindings": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "allowParentFromEffectiveRoot": {
                    "type": "boolean"
                  },
                  "parse": {
                    "type": "object",
                    "properties": {
                      "maxPositionIndex": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [],
                    "additionalProperties": false
                  },
                  "resolve": {
                    "type": "object",
                    "properties": {
                      "maxPropertyInspections": {},
                      "maxBindings": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              },
              "rebasedRoot": {
                "type": "string"
              },
              "contextualRoot": {
                "type": "string"
              },
              "omit": {
                "type": "array",
                "items": {
                  "enum": [
                    "scope",
                    "key",
                    "nodeKind",
                    "nodeTag",
                    "nodeHeads"
                  ]
                }
              },
              "invalidRoot": {
                "type": "boolean"
              },
              "faults": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "callback": {
                      "enum": [
                        "scope",
                        "key",
                        "nodeKind",
                        "nodeTag",
                        "nodeHeads",
                        "headNext",
                        "headEarlyClose"
                      ]
                    },
                    "binding": {
                      "type": "string"
                    },
                    "action": {
                      "enum": [
                        "return",
                        "throw",
                        "absent"
                      ]
                    },
                    "value": {},
                    "at": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "callback",
                    "binding",
                    "action",
                    "value"
                  ],
                  "additionalProperties": false
                }
              },
              "astFault": {
                "enum": [
                  "cycle",
                  "accessor"
                ]
              },
              "consumer": {
                "enum": [
                  "Activation",
                  "Graph",
                  "Instruction",
                  "Mutate",
                  "SO",
                  "AEOSPath",
                  "AEOSSelector",
                  "TypeTranspiler",
                  "EventPath",
                  "StoragePath",
                  "CloneReference",
                  "PointerReference"
                ]
              },
              "activation": {
                "enum": [
                  "trusted",
                  "constrained"
                ]
              },
              "repeat": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2
              },
              "reenter": {
                "type": "object",
                "properties": {
                  "callback": {
                    "const": "key"
                  },
                  "source": {
                    "type": "string"
                  },
                  "maxPropertyInspections": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "callback",
                  "source",
                  "maxPropertyInspections"
                ],
                "additionalProperties": false
              },
              "wideHeads": {
                "type": "object",
                "properties": {
                  "count": {
                    "enum": [
                      64,
                      128
                    ]
                  },
                  "matchAt": {
                    "enum": [
                      "none",
                      "first",
                      "last"
                    ]
                  }
                },
                "required": [
                  "count",
                  "matchAt"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "operation"
            ],
            "additionalProperties": false
          },
          "expected": {
            "type": "object",
            "properties": {
              "ok": {
                "type": "boolean"
              },
              "canonical": {
                "type": "string"
              },
              "isExact": {
                "type": "boolean"
              },
              "error": {
                "type": "string"
              },
              "causeCode": {
                "type": "string"
              },
              "limitKind": {
                "enum": [
                  "payloadScalars",
                  "selectors",
                  "canonicalScalars"
                ]
              },
              "limit": {
                "type": "integer",
                "minimum": 0
              },
              "observed": {
                "type": "integer",
                "minimum": 0
              },
              "budget": {
                "const": "maxPropertyInspections"
              },
              "selectorIndex": {
                "type": "integer",
                "minimum": 0
              },
              "phase": {
                "enum": [
                  "parse",
                  "policy",
                  "from",
                  "where",
                  "order",
                  "select"
                ]
              },
              "bindings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "addresses": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "records": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "candidate": {
                      "type": "string"
                    },
                    "valueBindings": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "candidate",
                    "valueBindings"
                  ],
                  "additionalProperties": false
                }
              },
              "calls": {
                "type": "object",
                "properties": {
                  "root": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "children": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "scope": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "key": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "nodeKind": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "nodeTag": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "nodeHeads": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "headNext": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "headEarlyClose": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [],
                "additionalProperties": false
              },
              "inputUnchanged": {
                "type": "boolean"
              },
              "astGetterCalls": {
                "type": "integer",
                "minimum": 0
              },
              "currentPropertyScope": {
                "const": "current"
              },
              "currentAddressRoot": {
                "const": "contextual"
              },
              "mustNotResolve": {
                "type": "boolean"
              },
              "nestedResultsOk": {
                "type": "boolean"
              }
            },
            "required": [
              "ok"
            ],
            "additionalProperties": false
          },
          "covers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "syntax",
                "unicode",
                "ast",
                "bounds",
                "key",
                "tag",
                "scope",
                "ownership",
                "order-multiplicity",
                "preflight",
                "budget",
                "iterator",
                "query",
                "consumer-denial",
                "legacy",
                "head-tag-split"
              ]
            }
          }
        },
        "required": [
          "id",
          "description",
          "input",
          "expected",
          "covers"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "meta",
    "id",
    "title",
    "tests"
  ],
  "additionalProperties": false
}

  "id": "property-boundaries",
  "title": "Property candidate boundaries",
  "tests": [
    {
      "id": "sansa-properties-deny-mutate-text",
      "description": "deny mutate text",
      "input": {
        "operation": "consumer-boundary",
        "namespace": "properties",
        "consumer": "Mutate",
        "source": "$.document&key(\"document\")"
      },
      "expected": {
        "ok": false,
        "mustNotResolve": true,
        "calls": {
          "scope": 0,
          "key": 0,
          "nodeHeads": 0
        },
        "error": "SANSA_MUTATE_NON_EXACT_TARGET"
      },
      "covers": [
        "consumer-denial"
      ]
    },
    {
      "id": "sansa-properties-deny-mutate-ast",
      "description": "deny mutate ast",
      "input": {
        "operation": "consumer-boundary",
        "namespace": "properties",
        "consumer": "Mutate",
        "ast": {
          "type": "SansaAddress",
          "root": {
            "type": "root",
            "kind": "absolute"
          },
          "selectors": [
            {
              "type": "member",
              "name": "document",
              "quoted": false
            },
            {
              "type": "propertyFilter",
              "property": "key",
              "value": "document"
            }
          ],
          "qualifierExpression": null,
          "canonical": "$.ordinary",
          "isExact": true
        }
      },
      "expected": {
        "ok": false,
        "mustNotResolve": true,
        "calls": {
          "scope": 0,
          "key": 0,
          "nodeHeads": 0
        },
        "error": "SANSA_MUTATE_NON_EXACT_TARGET"
      },
      "covers": [
        "consumer-denial",
        "ast"
      ]
    },

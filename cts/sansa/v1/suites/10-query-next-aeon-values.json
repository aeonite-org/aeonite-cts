{
  "meta": {
    "suite_id": "query-next-aeon-values",
    "lane": "sansa-query",
    "capability": "SANSA.Query",
    "sut_protocol": "cts.protocol.v1",
    "spec_refs": [
      "aeonite-specs/sources/sansa/v1/query-v1.aeon",
      "aeonite-specs/sources/aeon/v1/value-types-v1.aeon"
    ]
  },
  "id": "query-next-aeon-values",
  "title": "Next SANSA Query AEON Value Alignment",
  "fixtures": {
    "namespaces": [
      {
        "id": "portable-scalar-kinds",
        "root": {
          "address": "$",
          "representationKind": "ObjectLiteral",
          "children": [
            { "name": "date", "address": "$.date", "representationKind": "DateLiteral", "semanticType": "date", "value": "2024-02-29" },
            { "name": "time", "address": "$.time", "representationKind": "TimeLiteral", "semanticType": "time", "value": "10:20:30Z" },
            { "name": "datetime", "address": "$.datetime", "representationKind": "DateTimeLiteral", "semanticType": "datetime", "value": "2024-02-29T10:20:30Z" },
            { "name": "wtc", "address": "$.wtc", "representationKind": "WTCDateTimeLiteral", "semanticType": "wtc", "value": "2024-02-29T10:20:30Z&Europe" },
            { "name": "toggle", "address": "$.toggle", "representationKind": "ToggleLiteral", "value": "yes" },
            { "name": "hex", "address": "$.hex", "representationKind": "HexLiteral", "value": "ff00aa" },
            { "name": "radix", "address": "$.radix", "representationKind": "RadixLiteral", "value": "ff" },
            { "name": "encoding", "address": "$.encoding", "representationKind": "EncodingLiteral", "value": "Zg==" },
            { "name": "separator", "address": "$.separator", "representationKind": "SeparatorLiteral", "value": "1.2.3" },
            { "name": "symbol", "address": "$.symbol", "representationKind": "SymbolicLiteral", "value": "approved" }
          ]
        }
      }
    ]
  },
  "tests": [
    {
      "id": "sansa-query-next-values-001-year-clock-wtc",
      "input": {
        "expression": "2024-T10:&Europe"
      },
      "expected": {
        "ok": true,
        "canonical": "2024-T10:&Europe",
        "ast": {
          "type": "literalExpression",
          "kind": "wtc",
          "value": "2024-T10:&Europe"
        }
      }
    },
    {
      "id": "sansa-query-next-values-002-month-clock-offset",
      "input": {
        "expression": "2024-02T10-00:00"
      },
      "expected": {
        "ok": true,
        "canonical": "2024-02T10-00:00",
        "ast": {
          "kind": "datetime",
          "value": "2024-02T10-00:00"
        }
      }
    },
    {
      "id": "sansa-query-next-values-003-reduced-clock-named-place",
      "input": {
        "source": "from $.value\nselect 2024-T10:Z&+/Antarctica/Elisabeth"
      },
      "expected": {
        "ok": true,
        "canonical": "from $.value\nselect 2024-T10:Z&+/Antarctica/Elisabeth"
      }
    },
    {
      "id": "sansa-query-next-values-004-second-60-authored-scale",
      "input": {
        "expression": "23:59:60.000000000000000000000000100Z"
      },
      "expected": {
        "ok": true,
        "canonical": "23:59:60.000000000000000000000000100Z",
        "ast": {
          "kind": "time",
          "value": "23:59:60.000000000000000000000000100Z"
        }
      }
    },
    {
      "id": "sansa-query-next-values-005-day-padding-required",
      "input": {
        "expression": "2024-01-1"
      },
      "expected": {
        "ok": false,
        "error": "SANSA_QUERY_INVALID_TEMPORAL_LITERAL"
      }
    },
    {
      "id": "sansa-query-next-values-006-clock-no-empty-interior-field",
      "input": {
        "expression": "10::20"
      },
      "expected": {
        "ok": false,
        "error": "SANSA_QUERY_INVALID_TEMPORAL_LITERAL"
      }
    },
    {
      "id": "sansa-query-next-values-007-local-case-sensitive",
      "input": {
        "expression": "2024-T10:&Local"
      },
      "expected": {
        "ok": false,
        "error": "SANSA_QUERY_INVALID_TEMPORAL_LITERAL"
      }
    },
    {
      "id": "sansa-query-next-values-008-reduced-wtc-not-comment",
      "input": {
        "expression": "2024-T10:&Europe//Brussels"
      },
      "expected": {
        "ok": false,
        "error": "SANSA_QUERY_INVALID_TEMPORAL_LITERAL"
      }
    },
    {
      "id": "sansa-query-next-values-009-nested-fractional-wtc-not-comment",
      "input": {
        "expression": "temporalRelation(2024-02T10:20:30.100&Europe/*x*/Brussels, 2024-02T10:20:30.100&Europe)"
      },
      "expected": {
        "ok": false,
        "error": "SANSA_QUERY_INVALID_TEMPORAL_LITERAL"
      }
    },
    {
      "id": "sansa-query-next-values-010-duplicate-date-separator",
      "input": {
        "expression": "2024--02"
      },
      "expected": {
        "ok": false,
        "error": "SANSA_QUERY_INVALID_TEMPORAL_LITERAL"
      }
    },
    {
      "id": "sansa-query-next-values-011-portable-temporal-bindings",
      "description": "Portable representation kinds preserve temporal families without redundant scalarKind hints.",
      "input": {
        "namespace": "portable-scalar-kinds",
        "source": "from $\nselect { date = temporalRelation($.date, 2024-02-29) time = temporalRelation($.time, 10:20:30Z) datetime = temporalRelation($.datetime, 2024-02-29T10:20:30Z) wtc = temporalRelation($.wtc, 2024-02-29T10:20:30Z&Europe) }"
      },
      "expected": {
        "ok": true,
        "resultAddresses": ["$"],
        "values": [{ "type": "object", "value": { "date": "equal", "time": "equal", "datetime": "equal", "wtc": "equal" } }]
      }
    },
    {
      "id": "sansa-query-next-values-012-portable-string-backed-families",
      "input": {
        "namespace": "portable-scalar-kinds",
        "source": "from $\nwhere $.toggle == yes and $.hex == #ff00aa and $.radix == %ff and $.encoding == &Zg== and $.separator == ^1.2.3 and $.symbol == |approved|\nselect true"
      },
      "expected": {
        "ok": true,
        "resultAddresses": ["$"],
        "values": [{ "type": "scalar", "value": true }]
      }
    },
    {
      "id": "sansa-query-next-values-013-portable-date-not-string",
      "input": {
        "namespace": "portable-scalar-kinds",
        "source": "from $.date\nwhere . == \"2024-02-29\"\nselect ."
      },
      "expected": {
        "ok": false,
        "error": "SANSA_QUERY_EVALUATE_INVALID_COMPARISON",
        "errorPhase": "where",
        "candidateAddress": "$.date"
      }
    },
    {
      "id": "sansa-query-next-values-014-portable-encoding-not-string-function",
      "input": {
        "namespace": "portable-scalar-kinds",
        "source": "from $.encoding\nselect lower(.)"
      },
      "expected": {
        "ok": false,
        "error": "SANSA_QUERY_EVALUATE_INVALID_FUNCTION_CALL",
        "errorPhase": "select",
        "candidateAddress": "$.encoding"
      }
    },
    {
      "id": "sansa-query-next-values-015-portable-symbol-not-string",
      "input": {
        "namespace": "portable-scalar-kinds",
        "source": "from $.symbol\nwhere . == \"approved\"\nselect ."
      },
      "expected": {
        "ok": false,
        "error": "SANSA_QUERY_EVALUATE_INVALID_COMPARISON",
        "errorPhase": "where",
        "candidateAddress": "$.symbol"
      }
    },
    {
      "id": "sansa-query-next-values-016-portable-kind-filter-unchanged",
      "input": {
        "namespace": "portable-scalar-kinds",
        "source": "from $.*%DateTimeLiteral\nselect ."
      },
      "expected": {
        "ok": true,
        "resultAddresses": ["$.datetime"],
        "selectedAddresses": [["$.datetime"]]
      }
    }
  ]
}

  "tests": [
    {
      "id": "sansa-mutate-001-plan-replace-exact",
      "tags": ["experimental"],
      "input": {
        "namespace": "mutable-inventory",
        "operation": {
          "op": "replace",
          "target": "$.inventory.sku",
          "value": "B-200"
        },
        "mode": "plan"
      },
      "expected": {
        "ok": true,
        "operations": [
          {
            "op": "replace",
            "target": "$.inventory.sku"
          }
        ]
      }
    },
    {
      "id": "sansa-mutate-002-apply-replace",
      "tags": ["experimental"],
      "input": {
        "namespace": "mutable-inventory",
        "operation": {
          "op": "replace",
          "target": "$.inventory.sku",
          "value": "B-200"
        },
        "mode": "apply"
      },
      "expected": {
        "ok": true,
        "operationStatuses": ["applied"],
        "operationReports": [
          {
            "targetAddress": "$.inventory.sku",
            "previousAddress": "$.inventory.sku",
            "affectedAddress": "$.inventory.sku",
            "resultingAddress": "$.inventory.sku"
          }
        ],
        "valuesByAddress": {
          "$.inventory.sku": "B-200"
        }
      }
    },
    {
      "id": "sansa-mutate-003-create-targets-parent-not-missing-child",
      "tags": ["experimental"],
      "input": {
        "namespace": "mutable-inventory",
        "operation": {
          "op": "create",
          "parent": "$.inventory",
          "name": "status",
          "value": "active"
        },
        "mode": "apply"
      },
      "expected": {
        "ok": true,
        "operationReports": [
          {
            "parentAddress": "$.inventory",
            "affectedAddress": "$.inventory.status",
            "resultingAddress": "$.inventory.status"
          }
        ],
        "childrenByAddress": {
          "$.inventory": ["sku", "name", "status"]
        },
        "valuesByAddress": {
          "$.inventory.status": "active"
        }
      }
    },

  "tests": [
    {
      "id": "sansa-query-evaluate-001-filter-project",
      "description": "Evaluator filters candidate bindings and projects scalar fields.",
      "input": {
        "namespace": "inventory-values",
        "source": "from $.inventory.items.*\nwhere .qty >= 2 and .active == true\nselect { sku = .sku qty = .qty }"
      },
      "expected": {
        "ok": true,
        "resultAddresses": ["$.inventory.items[1]"],
        "values": [
          {
            "type": "object",
            "value": {
              "sku": "B-200",
              "qty": 4
            }
          }
        ]
      },
      "tags": ["sansa", "query", "evaluate", "projection"]
    },
    {
      "id": "sansa-query-evaluate-002-offset-limit",
      "description": "Evaluator applies offset and limit after filtering.",
      "input": {
        "namespace": "inventory-values",
        "source": "from $.inventory.items.*\nwhere .qty >= 1\noffset 1\nlimit 1\nselect .sku"
      },
      "expected": {
        "ok": true,
        "resultAddresses": ["$.inventory.items[1]"],
        "selectedAddresses": [
          ["$.inventory.items[1].sku"]
        ]
      },
      "tags": ["sansa", "query", "evaluate", "slice"]
    },
    {
      "id": "sansa-query-evaluate-003-order-offset-limit",
      "description": "Evaluator applies stable order by before offset and limit.",
      "input": {
        "namespace": "inventory-values",
        "source": "from $.inventory.items.*\norder by .qty desc\noffset 1\nlimit 2\nselect .sku"
      },
      "expected": {
        "ok": true,
        "resultAddresses": [
          "$.inventory.items[1]",
          "$.inventory.items[3]"
        ],
        "selectedAddresses": [
          ["$.inventory.items[1].sku"],
          ["$.inventory.items[3].sku"]
        ]
      },
      "tags": ["sansa", "query", "evaluate", "order", "slice"]
    },
    {
      "id": "sansa-query-evaluate-004-where-not-boolean",
      "description": "Where expressions must evaluate to Boolean true or false.",
      "input": {
        "namespace": "inventory-values",
        "source": "from $.inventory.items.*\nwhere .sku\nselect .sku"
      },
      "expected": {
        "ok": false,
        "error": "SANSA_QUERY_EVALUATE_EXPECTED_BOOLEAN",
        "errorPhase": "where",
        "candidateAddress": "$.inventory.items[0]"
      },
      "tags": ["sansa", "query", "evaluate", "negative"]
    },
    {
      "id": "sansa-query-evaluate-005-unsupported-function",
      "description": "The evaluator scaffold rejects unsupported function calls explicitly.",
      "input": {
        "namespace": "inventory-values",
        "source": "from $.inventory.items.*\nselect endsWith(.sku, \"B\")"
      },
      "expected": {
        "ok": false,
        "error": "SANSA_QUERY_EVALUATE_UNSUPPORTED_FUNCTION"
      },
      "tags": ["sansa", "query", "evaluate", "negative"]
    },
    {
      "id": "sansa-query-evaluate-006-cardinality-any",
      "description": "The evaluator scaffold supports any over a resolved binding-set predicate.",
      "input": {
        "namespace": "inventory-values",
        "source": "from $.inventory.items.*\nwhere any(.roles.* == \"admin\")\nselect .sku"
      },
      "expected": {
        "ok": true,
        "resultAddresses": [
          "$.inventory.items[0]",
          "$.inventory.items[3]"
        ]
      },
      "tags": ["sansa", "query", "evaluate", "cardinality"]
    },
    {
      "id": "sansa-query-evaluate-007-cardinality-all-empty",
      "description": "all(empty) evaluates to true.",
      "input": {
        "namespace": "inventory-values",
        "source": "from $.inventory.items.*\nwhere all(.roles.* == \"admin\")\nselect .sku"
      },
      "expected": {
        "ok": true,
        "resultAddresses": [
          "$.inventory.items[2]",
          "$.inventory.items[3]"
        ]
      },
      "tags": ["sansa", "query", "evaluate", "cardinality", "empty"]
    },
    {
      "id": "sansa-query-evaluate-008-cardinality-none-empty",
      "description": "none(empty) evaluates to true.",
      "input": {
        "namespace": "inventory-values",
        "source": "from $.inventory.items.*\nwhere none(.roles.* == \"admin\")\nselect .sku"
      },
      "expected": {
        "ok": true,
        "resultAddresses": [
          "$.inventory.items[1]",
          "$.inventory.items[2]"
        ]
      },
      "tags": ["sansa", "query", "evaluate", "cardinality", "empty"]
    },
    {
      "id": "sansa-query-evaluate-009-function-filter",
      "description": "Built-in contains may be used as a Boolean filter expression.",
      "input": {
        "namespace": "inventory-values",
        "source": "from $.inventory.items.*\nwhere contains(.sku, \"B\")\nselect .sku"
      },
      "expected": {
        "ok": true,
        "resultAddresses": ["$.inventory.items[1]"]
      },
      "tags": ["sansa", "query", "evaluate", "function"]
    },
    {
      "id": "sansa-query-evaluate-010-existence-present",
      "description": "exists returns true when the resolution expression resolves one or more bindings.",
      "input": {
        "namespace": "inventory-values",
        "source": "from $.inventory.items.*\nwhere exists(.roles)\nselect .sku"
      },
      "expected": {
        "ok": true,
        "resultAddresses": [
          "$.inventory.items[0]",
          "$.inventory.items[1]",
          "$.inventory.items[2]",
          "$.inventory.items[3]"
        ]
      },
      "tags": ["sansa", "query", "evaluate", "existence"]
    },
    {
      "id": "sansa-query-evaluate-011-existence-empty-container",
      "description": "exists on a container combined with absent on its expansion selects present empty containers.",
      "input": {
        "namespace": "inventory-values",
        "source": "from $.inventory.items.*\nwhere exists(.roles) and absent(.roles.*)\nselect .sku"
      },
      "expected": {
        "ok": true,
        "resultAddresses": [
          "$.inventory.items[2]"
        ]
      },
      "tags": ["sansa", "query", "evaluate", "existence", "empty"]
    },
    {
      "id": "sansa-query-evaluate-012-existence-missing",
      "description": "absent returns true when the resolution expression resolves zero bindings.",
      "input": {
        "namespace": "inventory-values",
        "source": "from $.inventory.items.*\nwhere absent(.deletedAt)\nselect .sku"
      },
      "expected": {
        "ok": true,
        "resultAddresses": [
          "$.inventory.items[0]",
          "$.inventory.items[1]",
          "$.inventory.items[2]",
          "$.inventory.items[3]"
        ]
      },
      "tags": ["sansa", "query", "evaluate", "existence", "missing"]
    },
    {
      "id": "sansa-query-evaluate-013-null-reason",
      "description": "isNullReason tests explicit null values without matching missing bindings.",
      "input": {
        "namespace": "inventory-values",
        "source": "from $.inventory.items.*\nwhere exists(.status) and isNullReason(.status, \"notSet\")\nselect .sku"
      },
      "expected": {
        "ok": true,
        "resultAddresses": [
          "$.inventory.items[0]"
        ]
      },
      "tags": ["sansa", "query", "evaluate", "null", "absence"]
    },
    {
      "id": "sansa-query-evaluate-014-missing-vs-null",
      "description": "absent tests missing bindings and does not match explicit null values.",
      "input": {
        "namespace": "inventory-values",
        "source": "from $.inventory.items.*\nwhere absent(.status)\nselect .sku"
      },
      "expected": {
        "ok": true,
        "resultAddresses": [
          "$.inventory.items[2]"
        ]
      },
      "tags": ["sansa", "query", "evaluate", "missing", "null"]
    },
    {
      "id": "sansa-query-evaluate-015-unguarded-null-test-missing",
      "description": "isNull is a scalar value test and reports missing when its operand resolves no bindings.",
      "input": {
        "namespace": "inventory-values",
        "source": "from $.inventory.items[2]\nwhere isNull(.status)\nselect .sku"
      },
      "expected": {
        "ok": false,
        "error": "SANSA_QUERY_EVALUATE_MISSING_SCALAR"
      },
      "tags": ["sansa", "query", "evaluate", "negative", "missing", "null"]
    },
    {
      "id": "sansa-query-evaluate-016-nan-predicate",
      "description": "isNaN tests explicit NaN values without relying on equality comparison.",
      "input": {
        "namespace": "inventory-values",
        "source": "from $.inventory.items.*\nwhere exists(.metric) and isNaN(.metric)\nselect .sku"
      },
      "expected": {
        "ok": true,
        "resultAddresses": [
          "$.inventory.items[2]"
        ]
      },
      "tags": ["sansa", "query", "evaluate", "nan", "numeric-special"]
    },
    {
      "id": "sansa-query-evaluate-017-infinity-predicate",
      "description": "isInfinity tests explicit Infinity values.",
      "input": {
        "namespace": "inventory-values",
        "source": "from $.inventory.items.*\nwhere exists(.ceiling) and isInfinity(.ceiling)\nselect .sku"
      },
      "expected": {
        "ok": true,
        "resultAddresses": [
          "$.inventory.items[3]"
        ]
      },
      "tags": ["sansa", "query", "evaluate", "infinity", "numeric-special"]
    },
    {
      "id": "sansa-query-evaluate-018-nan-comparison-invalid",
      "description": "NaN is not comparable; explicit predicates are required for NaN tests.",
      "input": {
        "namespace": "inventory-values",
        "source": "from $.inventory.items[2]\nwhere .metric == .metric\nselect .sku"
      },
      "expected": {
        "ok": false,
        "error": "SANSA_QUERY_EVALUATE_INVALID_COMPARISON",
        "errorPhase": "where",
        "candidateAddress": "$.inventory.items[2]"
      },
      "tags": ["sansa", "query", "evaluate", "negative", "nan", "comparison"]
    },
    {
      "id": "sansa-query-evaluate-019-number-comparison",
      "description": "Number values may participate in same-type ordering comparison.",
      "input": {
        "namespace": "inventory-values",
        "source": "from $.inventory.items[0]\nwhere .qty < 2\nselect .sku"
      },
      "expected": {
        "ok": true,
        "resultAddresses": [
          "$.inventory.items[0]"
        ]
      },
      "tags": ["sansa", "query", "evaluate", "comparison", "number"]
    },
    {
      "id": "sansa-query-evaluate-020-string-equality",
      "description": "String values may participate in same-type equality comparison.",
      "input": {
        "namespace": "inventory-values",
        "source": "from $.inventory.items.*\nwhere .sku == \"B-200\"\nselect .sku"
      },
      "expected": {
        "ok": true,
        "resultAddresses": [
          "$.inventory.items[1]"
        ]
      },
      "tags": ["sansa", "query", "evaluate", "comparison", "string"]
    },
    {
      "id": "sansa-query-evaluate-021-boolean-equality",
      "description": "Boolean values may participate in same-type equality comparison.",
      "input": {
        "namespace": "inventory-values",
        "source": "from $.inventory.items.*\nwhere .active == false\nselect .sku"
      },
      "expected": {
        "ok": true,
        "resultAddresses": [
          "$.inventory.items[2]",
          "$.inventory.items[3]"
        ]
      },
      "tags": ["sansa", "query", "evaluate", "comparison", "boolean"]
    },
    {
      "id": "sansa-query-evaluate-022-infinity-comparison",
      "description": "Infinity values may participate in same-type numeric comparison as bounds.",
      "input": {
        "namespace": "inventory-values",
        "source": "from $.inventory.items[3]\nwhere .ceiling > 1000000\nselect .sku"
      },
      "expected": {
        "ok": true,
        "resultAddresses": [
          "$.inventory.items[3]"
        ]
      },
      "tags": ["sansa", "query", "evaluate", "comparison", "infinity"]
    },
    {
      "id": "sansa-query-evaluate-023-null-comparison-invalid",
      "description": "Explicit null values are not compared by ordinary equality operators.",
      "input": {
        "namespace": "inventory-values",
        "source": "from $.inventory.items[0]\nwhere .status == .status\nselect .sku"
      },
      "expected": {
        "ok": false,
        "error": "SANSA_QUERY_EVALUATE_INVALID_COMPARISON"
      },
      "tags": ["sansa", "query", "evaluate", "negative", "comparison", "null"]
    },
    {
      "id": "sansa-query-evaluate-024-boolean-order-invalid",
      "description": "Boolean values are not orderable.",
      "input": {
        "namespace": "inventory-values",
        "source": "from $.inventory.items[0]\nwhere .active > false\nselect .sku"
      },
      "expected": {
        "ok": false,
        "error": "SANSA_QUERY_EVALUATE_INVALID_COMPARISON"
      },
      "tags": ["sansa", "query", "evaluate", "negative", "comparison", "boolean"]
    },
    {
      "id": "sansa-query-evaluate-025-semantic-filter-guard",
      "description": "A semantic type filter can guard scalar comparison against mixed-type bindings.",
      "input": {
        "namespace": "inventory-values",
        "source": "from $.inventory.items.*\nwhere exists(.id#number) and .id > 2\nselect .sku"
      },
      "expected": {
        "ok": true,
        "resultAddresses": [
          "$.inventory.items[3]"
        ]
      },
      "tags": ["sansa", "query", "evaluate", "existence", "semantic-filter"]
    },
    {
      "id": "sansa-query-evaluate-026-unguarded-mixed-type-comparison",
      "description": "A presence check without a semantic type filter does not protect mixed-type scalar comparison.",
      "input": {
        "namespace": "inventory-values",
        "source": "from $.inventory.items.*\nwhere exists(.id) and .id > 2\nselect .sku"
      },
      "expected": {
        "ok": false,
        "error": "SANSA_QUERY_EVALUATE_INVALID_COMPARISON"
      },
      "tags": ["sansa", "query", "evaluate", "negative", "semantic-filter"]
    },
    {
      "id": "sansa-query-evaluate-027-and-short-circuit",
      "description": "and short-circuits when the left operand is false.",
      "input": {
        "namespace": "inventory-values",
        "source": "from $.inventory.items[2]\nwhere .active == true and .deletedAt == \"never evaluated\"\nselect .sku"
      },
      "expected": {
        "ok": true,
        "resultAddresses": []
      },
      "tags": ["sansa", "query", "evaluate", "boolean", "short-circuit"]
    },
    {
      "id": "sansa-query-evaluate-028-or-short-circuit",
      "description": "or short-circuits when the left operand is true.",
      "input": {
        "namespace": "inventory-values",
        "source": "from $.inventory.items[0]\nwhere .active == true or .deletedAt == \"never evaluated\"\nselect .sku"
      },
      "expected": {
        "ok": true,
        "resultAddresses": [
          "$.inventory.items[0]"
        ]
      },

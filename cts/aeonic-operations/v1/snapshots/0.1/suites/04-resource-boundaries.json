{
  "id": "04-resource-boundaries",
  "status": "working",
  "tests": [
    {
      "id": "minimum_coefficient_capacity",
      "operation": "compare",
      "left": {
        "recipe": "1 followed by 65535 zeroes"
      },
      "right": {
        "recipe": "2 followed by 65535 zeroes"
      },
      "expectedSymbol": "less",
      "requiredCapabilities": [
        "comparison-baseline"
      ],
      "kind": "resource-boundary"
    },
    {
      "id": "integer_exponent_equivalence_at_capacity",
      "operation": "compare",
      "left": {
        "recipe": "1 followed by 65535 zeroes"
      },
      "right": {
        "category": "finiteNumber",
        "value": "1e65535"
      },
      "expectedSymbol": "equal",
      "requiredCapabilities": [
        "comparison-baseline"
      ],
      "kind": "resource-boundary"
    },
    {
      "id": "minimum_exponent_capacity",
      "operation": "compare",
      "left": {
        "recipe": "1e followed by 65534 nines"
      },
      "right": {
        "recipe": "1e followed by 65533 nines then 8"
      },
      "expectedSymbol": "greater",
      "requiredCapabilities": [
        "comparison-baseline"
      ],
      "kind": "resource-boundary"
    },
    {
      "id": "configured_numeric_limit_exceeded",
      "operation": "compare",
      "harnessLimits": {
        "maxNumericCharacters": 65536
      },
      "left": {
        "recipe": "1 followed by 65536 zeroes"
      },
      "right": {
        "category": "finiteNumber",
        "value": "1"
      },
      "expectedDiagnostic": {

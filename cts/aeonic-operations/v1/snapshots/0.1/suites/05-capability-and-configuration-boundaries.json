{
  "id": "05-capability-and-configuration-boundaries",
  "status": "working",
  "tests": [
    {
      "id": "unavailable_declared_order_before_operand_validation",
      "expected": {
        "outcome": "diagnostic",
        "reason": "unsupported_profile",
        "context": {
          "stage": 3,
          "path": "/input/policy/symbols/mode"
        }
      },
      "fixture": {
        "request": {
          "operation": "compare",
          "input": {
            "left": {
              "category": "symbol",
              "value": 42
            },
            "right": {
              "category": "symbol",
              "value": "high"
            },
            "policy": {
              "symbols": {
                "mode": "declared-order",
                "declaration": {
                  "order": [
                    {
                      "category": "symbol",
                      "value": "low"
                    },
                    {
                      "category": "symbol",
                      "value": "high"
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "requiredCapabilities": [
        "comparison-baseline"
      ],
      "assertAbsent": [
        "value"
      ],
      "invocationProfile": "without-declared-order"
    },
    {
      "id": "empty_declaration_before_unavailable_optional_profile",
      "expected": {
        "outcome": "diagnostic",
        "reason": "invalid_policy",
        "context": {
          "stage": 3,
          "path": "/input/policy/symbols/declaration/order"
        }
      },
      "assertAbsent": [
        "value"
      ],
      "fixture": {
        "request": {
          "operation": "compare",
          "input": {
            "left": {
              "category": "symbol",
              "value": "low"
            },
            "right": {
              "category": "symbol",
              "value": "high"
            },
            "policy": {
              "symbols": {
                "mode": "declared-order",
                "declaration": {
                  "order": []
                }
              }
            }
          }
        }
      },
      "requiredCapabilities": [
        "comparison-baseline"
      ],
      "invocationProfile": "without-declared-order"
    },
    {
      "id": "overridden_unavailable_declared_order_not_resolved",
      "expected": {
        "outcome": "value",
        "value": {
          "category": "symbol",
          "value": "less"
        },
        "metadata": {
          "effectivePolicy": {
            "profile": "aeonic.operations.comparison.baseline.v1",
            "domain": "symbol",
            "comparison": "string-profile",
            "strings": {
              "profile": "aeonic.operations.string.codepoint.v1"
            },
            "symbols": {
              "mode": "string-profile",
              "profile": "aeonic.operations.string.codepoint.v1"
            }
          }
        }
      },
      "fixture": {
        "request": {
          "operation": "compare",
          "input": {
            "left": {
              "category": "symbol",
              "value": "high"
            },
            "right": {
              "category": "symbol",
              "value": "low"
            },
            "context": {
              "symbols": {
                "mode": "declared-order",
                "declaration": {
                  "order": [
                    {
                      "category": "symbol",
                      "value": "low"
                    },
                    {
                      "category": "symbol",
                      "value": "high"
                    }
                  ]
                }
              }
            },
            "policy": {
              "symbols": {
                "mode": "string-profile",
                "profile": "aeonic.operations.string.codepoint.v1"
              }
            }
          }
        }
      },
      "requiredCapabilities": [
        "comparison-baseline"
      ],
      "invocationProfile": "without-declared-order"
    },
    {
      "id": "empty_named_declaration",
      "expected": {
        "outcome": "diagnostic",
        "reason": "invalid_policy",
        "context": {
          "stage": 3,
          "path": "/input/context/declarations/0/order"
        }
      },
      "fixture": {
        "request": {
          "operation": "compare",
          "input": {
            "left": {
              "category": "finiteNumber",
              "value": "1"
            },
            "right": {
              "category": "finiteNumber",
              "value": "1"
            },
            "context": {
              "declarations": [
                {
                  "id": "empty",
                  "version": "1",
                  "order": []
                }
              ]
            }
          }
        }
      },
      "requiredCapabilities": [
        "comparison-baseline"
      ],
      "assertAbsent": [
        "value"
      ]
    },
    {
      "id": "misspelled_policy_field_is_not_ignored",
      "expected": {
        "outcome": "diagnostic",
        "reason": "invalid_policy",
        "context": {
          "stage": 3,
          "path": "/input/policy/profle"
        }
      },
      "fixture": {
        "request": {
          "operation": "compare",
          "input": {
            "left": {
              "category": "finiteNumber",
              "value": "1"
            },
            "right": {
              "category": "finiteNumber",
              "value": "1"
            },
            "policy": {
              "profle": "app.unavailable.v1"
            }
          }
        }
      },
      "requiredCapabilities": [
        "comparison-baseline"
      ],
      "assertAbsent": [
        "value"
      ]
    },
    {
      "id": "non_scalar_unknown_configuration_key_has_no_fabricated_pointer",
      "requiredCapabilities": [
        "comparison-baseline"
      ],
      "fixture": {
        "request": {
          "operation": "compare",
          "input": {
            "left": {
              "category": "finiteNumber",
              "value": "1"
            },
            "right": {
              "category": "finiteNumber",
              "value": "2"
            },
            "policy": {
              "\ud800": 0
            }
          }
        }
      },
      "expected": {
        "outcome": "diagnostic",
        "reason": "invalid_policy",
        "context": {
          "stage": 3,
          "path": null
        }
      },
      "assertAbsent": [
        "value"
      ]
    },
    {
      "id": "duplicate_named_identity_with_different_bodies",
      "requiredCapabilities": [
        "comparison-baseline"
      ],
      "fixture": {
        "request": {
          "operation": "equal",
          "input": {
            "left": {
              "category": "finiteNumber",
              "value": "1"
            },
            "right": {
              "category": "finiteNumber",
              "value": "1"
            },
            "context": {
              "declarations": [
                {
                  "id": "same",
                  "version": "1",
                  "order": [
                    {
                      "category": "symbol",
                      "value": "a"
                    }
                  ]
                },
                {
                  "id": "same",
                  "version": "1",
                  "order": [
                    {
                      "category": "symbol",
                      "value": "b"
                    }
                  ]
                }
              ]
            }
          }
        }
      },
      "expected": {
        "outcome": "diagnostic",
        "reason": "invalid_policy",
        "context": {
          "stage": 3,
          "path": "/input/context/declarations/1"
        }
      },
      "assertAbsent": [
        "value"
      ]
    },
    {
      "id": "declared_membership_is_case_sensitive",
      "requiredCapabilities": [
        "comparison-baseline",
        "symbol-declared-order"
      ],
      "fixture": {
        "request": {
          "operation": "compare",
          "input": {
            "left": {
              "category": "symbol",
              "value": "Low"
            },
            "right": {
              "category": "symbol",
              "value": "high"
            },
            "policy": {
              "symbols": {
                "mode": "declared-order",
                "declaration": {
                  "order": [
                    {
                      "category": "symbol",
                      "value": "low"
                    },
                    {
                      "category": "symbol",
                      "value": "high"
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "expected": {
        "outcome": "diagnostic",
        "reason": "undeclared_symbol",
        "context": {
          "stage": 6,
          "path": "/input/left/value"
        }
      },
      "assertAbsent": [
        "value"
      ]
    },
    {
      "id": "duplicate_declared_symbol_after_json_escape_decoding",
      "requiredCapabilities": [
        "comparison-baseline"
      ],
      "fixture": {
        "requestText": "{\"operation\":\"compare\",\"input\":{\"left\":{\"category\":\"symbol\",\"value\":\"low\"},\"right\":{\"category\":\"symbol\",\"value\":\"high\"},\"policy\":{\"symbols\":{\"mode\":\"declared-order\",\"declaration\":{\"order\":[{\"category\":\"symbol\",\"value\":\"low\"},{\"category\":\"symbol\",\"value\":\"\\u006cow\"}]}}}}}"
      },
      "expected": {
        "outcome": "diagnostic",
        "reason": "invalid_policy",
        "context": {
          "stage": 3,
          "path": "/input/policy/symbols/declaration/order/1"
        }
      },
      "assertAbsent": [
        "value"
      ]
    }
  ]
}

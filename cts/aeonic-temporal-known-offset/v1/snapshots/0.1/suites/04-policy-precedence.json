{
  "id": "04-policy-precedence",
  "tests": [
    {
      "id": "invalid-destination-'-00:00'",
      "requires": [
        "conversion"
      ],
      "fixture": {
        "request": {
          "operation": "convert",
          "input": {
            "value": {
              "temporal": {
                "category": "knownOffsetDateTime",
                "value": "2024-03-01T10:00:00+01:00"
              }
            },
            "policy": {
              "destinationOffset": "-00:00"
            },
            "context": {
              "profile": "aeonic.operations.temporal.known-offset.v1"
            }
          }
        }
      },
      "expected": {
        "outcome": "diagnostic",
        "reason": "invalid_policy",
        "context": {
          "stage": 3,
          "path": "/input/policy/destinationOffset"
        }
      }
    },

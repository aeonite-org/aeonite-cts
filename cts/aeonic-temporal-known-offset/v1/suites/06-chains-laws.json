{
  "id": "06-chains-laws",
  "tests": [
    {
      "id": "actual-returned-chain",
      "kind": "chain",
      "requires": [
        "conversion"
      ],
      "steps": [
        {
          "request": {
            "operation": "convert",
            "input": {
              "value": {
                "temporal": {
                  "category": "knownOffsetDateTime",
                  "value": "2024-03-01T09:00:00.1+01:00"
                },
                "originDateGranularity": "year",
                "originClockForm": "hour",
                "history": {
                  "clamping": "clamping-declared",
                  "approximation": "approximation-declared"
                }
              },
              "policy": {
                "destinationOffset": "Z"
              },
              "context": {
                "profile": "aeonic.operations.temporal.known-offset.v1"
              }
            }
          },
          "expected": {
            "outcome": "value",
            "value": {
              "temporal": {
                "category": "knownOffsetDateTimeSet",
                "offset": "Z",
                "pieces": [
                  {
                    "kind": "point",
                    "at": "2024-03-01T08:00:00.1"
                  }
                ]
              },
              "originDateGranularity": "year",
              "originClockForm": "hour",
              "history": {
                "clamping": "clamping-declared",
                "approximation": "approximation-declared"
              },
              "originalOffset": "+01:00"
            },
            "metadata": {
              "evaluation": "exact-for-policy",
              "clamping": "not-applied",
              "effectivePolicy": {
                "destinationOffset": "Z",
                "profile": "aeonic.operations.temporal.known-offset.v1"
              }
            }
          }
        },
        {
          "request": {
            "operation": "convert",
            "input": {
              "value": {
                "temporal": {
                  "category": "knownOffsetDateTime",
                  "value": "2024-03-01T10:00:00+01:00"
                }
              },
              "policy": {
                "destinationOffset": "+02:00"
              },
              "context": {
                "profile": "aeonic.operations.temporal.known-offset.v1"
              }
            }
          },
          "expected": {
            "outcome": "value",
            "value": {
              "temporal": {
                "category": "knownOffsetDateTimeSet",
                "offset": "+02:00",
                "pieces": [
                  {
                    "kind": "point",
                    "at": "2024-03-01T10:00:00.1"
                  }
                ]
              },
              "originDateGranularity": "year",
              "originClockForm": "hour",
              "history": {
                "clamping": "clamping-declared",
                "approximation": "approximation-declared"
              },
              "originalOffset": "+01:00"
            },
            "metadata": {
              "evaluation": "exact-for-policy",
              "clamping": "not-applied",
              "effectivePolicy": {
                "destinationOffset": "+02:00",
                "profile": "aeonic.operations.temporal.known-offset.v1"
              }
            }
          }
        }
      ],
      "links": [
        {
          "fromStep": 0,
          "toStep": 1,
          "input": "value"
        }
      ]
    },

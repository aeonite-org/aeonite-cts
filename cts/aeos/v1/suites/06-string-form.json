{
  "meta": {
    "suite_id": "string-form",
    "spec_refs": ["specs/03-releases/r5/AEOS-spec-r5.md"],
    "constraint_primitives": ["min_length", "max_length"]
  },
  "id": "string-form",
  "title": "String Form Constraints",
  "requires": [
    "type-constraints"
  ],
  "tests": [
    {
      "id": "string_min_length_violation",
      "description": "String shorter than min_length should fail",
      "input": {
        "aes": [
          {
            "path": {
              "segments": [
                {
                  "type": "root"
                },
                {
                  "type": "member",
                  "key": "s"
                }
              ]
            },
            "key": "s",
            "value": {
              "type": "StringLiteral",
              "raw": "\"ab\"",
              "value": "ab"
            },
            "span": [
              30,
              31
            ]
          }
        ],
        "schema": {
          "rules": [
            {
              "path": "$.s",
              "constraints": {
                "type": "StringLiteral",
                "min_length": 3
              }
            }
          ]
        }
      },
      "expected": {
        "ok": false,
        "errors": [
          {
            "path": "$.s",
            "code": "string_length_violation",
            "phase": "schema_validation",
            "span": [
              30,
              31
            ]
          }
        ],
        "warnings": [],
        "guarantees": {}
      },
      "assert": {
        "no_mutation": true
      }
    },
    {
      "id": "string_max_length_violation",
      "description": "String longer than max_length should fail",
      "input": {
        "aes": [
          {
            "path": {
              "segments": [
                {
                  "type": "root"
                },
                {
                  "type": "member",
                  "key": "t"
                }
              ]
            },
            "key": "t",
            "value": {
              "type": "StringLiteral",
              "raw": "\"toolong\"",
              "value": "toolong"
            },
            "span": [
              32,
              33
            ]
          }
        ],
        "schema": {
          "rules": [
            {
              "path": "$.t",
              "constraints": {
                "type": "StringLiteral",
                "max_length": 3
              }
            }
          ]
        }
      },
      "expected": {
        "ok": false,
        "errors": [
          {
            "path": "$.t",
            "code": "string_length_violation",
            "phase": "schema_validation",
            "span": [
              32,
              33
            ]
          }
        ],
        "warnings": [],
        "guarantees": {}
      },
      "assert": {
        "no_mutation": true
      }
    },
    {
      "id": "string_pass_case",
      "description": "String meets min/max length constraints",
      "input": {
        "aes": [
          {
            "path": {
              "segments": [
                {
                  "type": "root"
                },
                {
                  "type": "member",
                  "key": "u"
                }
              ]
            },
            "key": "u",
            "value": {
              "type": "StringLiteral",
              "raw": "\"okay\"",
              "value": "okay"
            },
            "span": [
              34,
              35
            ]
          }
        ],
        "schema": {
          "rules": [
            {
              "path": "$.u",
              "constraints": {
                "type": "StringLiteral",
                "min_length": 1,
                "max_length": 10
              }
            }
          ]
        }
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "guarantees": {}
      },
      "assert": {
        "no_mutation": true
      }
    },
    {
      "id": "separator_max_length_violation",
      "description": "Separator literal payload longer than max_length should fail",
      "input": {
        "aes": [
          {
            "path": {
              "segments": [
                {
                  "type": "root"
                },
                {
                  "type": "member",
                  "key": "sep"
                }
              ]
            },
            "key": "sep",
            "datatype": "sep[\".\"]",
            "value": {
              "type": "SeparatorLiteral",
              "raw": "^hello.world",
              "value": "hello.world"
            },
            "span": [
              36,
              47
            ]
          }
        ],
        "schema": {
          "rules": [
            {
              "path": "$.sep",
              "constraints": {
                "type": "SeparatorLiteral",
                "max_length": 5
              }
            }
          ]
        }
      },
      "expected": {
        "ok": false,
        "errors": [
          {
            "path": "$.sep",
            "code": "string_length_violation",
            "phase": "schema_validation",
            "span": [
              36,
              47
            ]
          }
        ],
        "warnings": [],
        "guarantees": {}
      },
      "assert": {
        "no_mutation": true
      }
    },
    {
      "id": "null_max_length_violation",
      "description": "Null literal payload longer than max_length should fail",
      "input": {
        "aes": [
          {
            "path": {
              "segments": [
                {
                  "type": "root"
                },
                {
                  "type": "member",
                  "key": "reason"
                }
              ]
            },
            "key": "reason",
            "value": {
              "type": "NullLiteral",
              "raw": "!\"veryLongCustomNull\"",
              "value": "veryLongCustomNull"
            },
            "span": [
              48,
              69
            ]
          }
        ],
        "schema": {
          "rules": [
            {
              "path": "$.reason",
              "constraints": {
                "type": "NullLiteral",
                "max_length": 8
              }
            }
          ]
        }
      },
      "expected": {
        "ok": false,
        "errors": [
          {
            "path": "$.reason",
            "code": "string_length_violation",
            "phase": "schema_validation",
            "span": [
              48,
              69
            ]
          }
        ],
        "warnings": [],
        "guarantees": {}
      },
      "assert": {
        "no_mutation": true
      }
    },
    {
      "id": "encoding_min_length_violation",
      "description": "Encoding literal payload shorter than min_length should fail",
      "input": {
        "aes": [
          {
            "path": {
              "segments": [
                {
                  "type": "root"
                },
                {
                  "type": "member",
                  "key": "blob"
                }
              ]
            },
            "key": "blob",
            "value": {
              "type": "EncodingLiteral",
              "raw": "$QQ",
              "value": "QQ"
            },
            "span": [
              70,
              73
            ]
          }
        ],
        "schema": {
          "rules": [
            {
              "path": "$.blob",
              "constraints": {
                "type": "EncodingLiteral",
                "min_length": 4
              }
            }
          ]
        }
      },
      "expected": {
        "ok": false,
        "errors": [
          {
            "path": "$.blob",
            "code": "string_length_violation",
            "phase": "schema_validation",
            "span": [
              70,
              73
            ]
          }
        ],
        "warnings": [],
        "guarantees": {}
      },
      "assert": {
        "no_mutation": true
      }
    },
    {
      "id": "wtc_pattern_violation",
      "description": "WTC payload that does not match the declared pattern should fail",
      "input": {
        "aes": [
          {
            "path": {
              "segments": [
                {
                  "type": "root"
                },
                {
                  "type": "member",
                  "key": "stamp"
                }
              ]
            },
            "key": "stamp",
            "value": {
              "type": "WTCDateTimeLiteral",
              "raw": "@2026-05-25T12:34:56&local",
              "value": "2026-05-25T12:34:56&local"
            },
            "span": [
              74,
              102
            ]
          }
        ],
        "schema": {
          "rules": [
            {
              "path": "$.stamp",
              "constraints": {
                "type": "WTCDateTimeLiteral",
                "pattern": "&UTC$"
              }
            }
          ]
        }
      },
      "expected": {
        "ok": false,
        "errors": [
          {
            "path": "$.stamp",
            "code": "pattern_mismatch",
            "phase": "schema_validation",
            "span": [
              74,
              102
            ]
          }
        ],
        "warnings": [],
        "guarantees": {}
      },
      "assert": {
        "no_mutation": true
      }
    }
  ]
}

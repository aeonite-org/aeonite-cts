        "aes": [
          {
            "path": {
              "segments": [
                {
                  "type": "root"
                },
                {
                  "type": "member",
                  "key": "bits"
                }
              ]
            },
            "key": "bits",
            "datatype": "radix[2]",
            "value": {
              "type": "RadixLiteral",
              "raw": "%1010",
              "value": "1010"
            },
            "span": [
              34,
              39

{
  "meta": {
    "suite_id": "numeric-form",
    "spec_refs": ["specs/03-releases/r5/AEOS-spec-r5.md"],
    "constraint_primitives": ["sign", "min_digits", "max_digits", "radix", "allow_unspecified_radix"]
  },
  "id": "numeric-form",
  "title": "Numeric Form Constraints",
  "requires": [
    "type-constraints"
  ],
  "tests": [
    {
      "id": "numeric_signed_violation",
      "description": "Unsigned integer constraint violated by negative literal",
      "input": {
        "aes": [
          {
            "path": {
              "segments": [
                {
                  "type": "root"
                },
                {
                  "type": "member",
                  "key": "n"
                }
              ]
            },
            "key": "n",
            "value": {
              "type": "NumberLiteral",
              "raw": "-1",
              "value": "-1"
            },
            "span": [
              20,
              21
            ]
          }
        ],
        "schema": {
          "rules": [
            {
              "path": "$.n",
              "constraints": {
                "type": "IntegerLiteral",
                "sign": "unsigned"
              }
            }
          ]
        }
      },
      "expected": {
        "ok": false,
        "errors": [
          {
            "path": "$.n",
            "code": "numeric_form_violation",
            "phase": "schema_validation",
            "span": [
              20,
              21
            ]
          }
        ],
        "warnings": [],
        "guarantees": {}
      },
      "assert": {
        "no_mutation": true
      }
    },
    {

    {
      "id": "numeric_radix_unspecified_relaxed_pass",
      "description": "Radix literal with constrained radix may omit the declared datatype only when explicitly relaxed",
      "input": {
        "aes": [
          {
            "path": {
              "segments": [
                {
                  "type": "root"
                },
                {
                  "type": "member",
                  "key": "bits"
                }
              ]
            },
            "key": "bits",
            "value": {
              "type": "RadixLiteral",
              "raw": "%1010",
              "value": "1010"
            },
            "span": [
              46,

      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "guarantees": {}
      },
      "assert": {
        "no_mutation": true
      }
    },
    {
      "id": "numeric_radix_unspecified_violation",
      "description": "Radix literal with constrained radix requires a declared radix datatype by default",

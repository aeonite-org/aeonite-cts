      "expected": {
        "ok": false,
        "errors": [
          {
            "path": "$.bits",
            "code": "numeric_form_violation",
            "phase": "schema_validation",
            "span": [
              28,
              33
            ]
          }
        ],
        "warnings": [],
        "guarantees": {}
      },
      "assert": {
        "no_mutation": true
      }
    },

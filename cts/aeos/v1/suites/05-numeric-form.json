    {
      "id": "numeric_radix_violation",
      "description": "Radix literal contains a digit outside the declared radix",
      "input": {
        "aes": [
          {
            "path": {
              "segments": [
                {
                  "type": "root"
                },
                {
                  "type": "member",
                  "key": "bits"
                }
              ]
            },
            "key": "bits",
            "datatype": "radix[2]",
            "value": {
              "type": "RadixLiteral",
              "raw": "%1050",
              "value": "1050"
            },
            "span": [
              28,
              33
            ]
          }
        ],
        "schema": {
          "rules": [
            {
              "path": "$.bits",
              "constraints": {
                "type": "RadixLiteral",
                "radix": 2
              }
            }
          ]
        }

{
  "meta": {
    "suite_id": "pattern",
    "spec_refs": ["specs/03-releases/r5/AEOS-spec-r5.md"],
    "constraint_primitives": ["pattern"]
  },
  "id": "pattern",
  "title": "Pattern Constraints",
  "requires": [
    "string-form"
  ],
  "tests": [
    {
      "id": "pattern_match_pass",
      "description": "String matches pattern -> pass",
      "input": {
        "aes": [
          {
            "path": {
              "segments": [
                {
                  "type": "root"
                },
                {
                  "type": "member",
                  "key": "code"
                }
              ]
            },
            "key": "code",
            "value": {
              "type": "StringLiteral",
              "raw": "\"ABC-123\"",
              "value": "ABC-123"
            },
            "span": [
              60,
              61
            ]
          }
        ],
        "schema": {
          "rules": [
            {
              "path": "$.code",
              "constraints": {
                "type": "StringLiteral",
                "pattern": "^[A-Z]{3}-\\d{3}$"
              }
            }
          ]
        }
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "guarantees": {}
      },
      "assert": {
        "no_mutation": true
      }
    },
    {
      "id": "pattern_mismatch_fail",
      "description": "String does not match pattern -> pattern_mismatch",
      "input": {
        "aes": [
          {
            "path": {
              "segments": [
                {
                  "type": "root"
                },
                {
                  "type": "member",
                  "key": "code"
                }
              ]
            },
            "key": "code",
            "value": {
              "type": "StringLiteral",
              "raw": "\"abc123\"",
              "value": "abc123"
            },
            "span": [
              62,
              63
            ]
          }
        ],
        "schema": {
          "rules": [
            {
              "path": "$.code",
              "constraints": {
                "type": "StringLiteral",
                "pattern": "^[A-Z]{3}-\\d{3}$"
              }
            }
          ]
        }
      },
      "expected": {
        "ok": false,
        "errors": [
          {
            "path": "$.code",
            "code": "pattern_mismatch",
            "phase": "schema_validation",
            "span": [
              62,
              63
            ]
          }
        ],
        "warnings": [],
        "guarantees": {}
      },
      "assert": {
        "no_mutation": true
      }
    },
    {
      "id": "pattern_separator_datatype_rule_pass",
      "description": "Datatype rule pattern applies to separator literal normalized value -> pass",
      "input": {
        "aes": [
          {
            "path": {
              "segments": [
                { "type": "root" },
                { "type": "member", "key": "ip" }
              ]
            },
            "key": "ip",
            "datatype": "kadot",
            "value": {
              "type": "SeparatorLiteral",
              "raw": "^198.0.126.255",
              "value": "198.0.126.255"
            },
            "span": [64, 78]
          }
        ],
        "schema": {
          "rules": [
            {
              "path": "$.ip",
              "constraints": {}
            }
          ],
          "datatype_rules": {
            "kadot": {
              "type": "SeparatorLiteral",
              "pattern": "^[0-9]+(?:\\.[0-9]+)*$"
            }
          }
        }
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "guarantees": {}
      },
      "assert": {
        "no_mutation": true
      }
    },
    {
      "id": "pattern_separator_datatype_rule_fail",
      "description": "Datatype rule pattern rejects non-kadot separator literal value",
      "input": {
        "aes": [
          {
            "path": {
              "segments": [
                { "type": "root" },
                { "type": "member", "key": "dimensions" }
              ]
            },
            "key": "dimensions",
            "datatype": "kadot",
            "value": {
              "type": "SeparatorLiteral",
              "raw": "^300x250",
              "value": "300x250"
            },
            "span": [79, 87]
          }
        ],
        "schema": {
          "rules": [
            {
              "path": "$.dimensions",
              "constraints": {}
            }
          ],
          "datatype_rules": {
            "kadot": {
              "type": "SeparatorLiteral",
              "pattern": "^[0-9]+(?:\\.[0-9]+)*$"
            }
          }
        }
      },
      "expected": {
        "ok": false,
        "errors": [
          {
            "path": "$.dimensions",
            "code": "pattern_mismatch",
            "phase": "schema_validation",
            "span": [79, 87]
          }
        ],
        "warnings": [],
        "guarantees": {}
      },
      "assert": {
        "no_mutation": true
      }
    },
    {
      "id": "pattern_non_portable_lookahead_rejected",
      "description": "Lookahead pattern syntax is rejected as outside the AEOS portable pattern profile",
      "input": {
        "aes": [],
        "schema": {
          "rules": [
            {
              "path": "$.code",
              "constraints": {
                "type": "StringLiteral",
                "pattern": "^(?=ABC).+$"
              }
            }
          ]
        }
      },
      "expected": {
        "ok": false,
        "errors": [
          {
            "path": "$.code",
            "code": "unknown_constraint_key",
            "phase": "schema_validation",
            "span": null
          }
        ],
        "warnings": [],
        "guarantees": {}
      },
      "assert": {
        "no_mutation": true
      }
    },
    {
      "id": "pattern_non_portable_backreference_rejected",
      "description": "Backreference pattern syntax is rejected as outside the AEOS portable pattern profile",
      "input": {
        "aes": [],
        "schema": {
          "rules": [
            {
              "path": "$.code",
              "constraints": {
                "type": "StringLiteral",
                "pattern": "^(A)\\1$"
              }
            }
          ]
        }
      },
      "expected": {
        "ok": false,
        "errors": [
          {
            "path": "$.code",
            "code": "unknown_constraint_key",
            "phase": "schema_validation",
            "span": null
          }
        ],
        "warnings": [],
        "guarantees": {}
      },
      "assert": {
        "no_mutation": true
      }
    },
    {
      "id": "pattern_nested_quantifier_rejected",
      "description": "Nested quantified groups are rejected as outside the AEOS portable pattern profile",
      "input": {
        "aes": [],
        "schema": {
          "rules": [
            {
              "path": "$.code",
              "constraints": {
                "type": "StringLiteral",
                "pattern": "^(A+)+$"
              }
            }
          ]
        }
      },
      "expected": {
        "ok": false,
        "errors": [
          {
            "path": "$.code",
            "code": "unknown_constraint_key",
            "phase": "schema_validation",
            "span": null
          }
        ],
        "warnings": [],
        "guarantees": {}
      },
      "assert": {
        "no_mutation": true
      }
    }
  ]
}

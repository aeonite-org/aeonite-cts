            }
          }
        },
        {
          "request": {
            "operation": "shiftClock",
            "input": {
              "policy": {
                "profile": "aeonic.operations.temporal.civil-datetime.v1"
              },
              "value": {
                "temporal": {
                  "category": "civilDateTimeSet",
                  "pieces": [
                    {
                      "kind": "point",
                      "at": "2024-03-01T09:30:00.5"
                    }
                  ]
                },
                "originDateGranularity": "day",
                "originClockForm": "second",
                "history": {
                  "clamping": "none-declared",
                  "approximation": "approximation-declared"
                }
              },
              "amount": {
                "number": {
                  "category": "finiteNumber",
                  "value": "-.5"
                },
                "history": "none-declared"
              }
            }
          },
          "expected": {
            "outcome": "value",
            "value": {
              "temporal": {
                "category": "civilDateTimeSet",
                "pieces": [
                  {
                    "kind": "point",
                    "at": "2024-03-01T09:30:00"
                  }
                ]
              },
              "originDateGranularity": "day",
              "originClockForm": "second",
              "history": {
                "clamping": "none-declared",
                "approximation": "approximation-declared"
              }
            },
            "metadata": {
              "evaluation": "exact-for-policy",
              "clamping": "not-applied",
              "effectivePolicy": {
                "profile": "aeonic.operations.temporal.civil-datetime.v1"
              }
            }
          }
        },
        {
          "request": {
            "operation": "materialize",
            "input": {
              "policy": {
                "profile": "aeonic.operations.temporal.civil-datetime.v1",
                "dateGranularity": "day",
                "clockForm": "second"
              },
              "value": {
                "temporal": {
                  "category": "civilDateTimeSet",
                  "pieces": [
                    {
                      "kind": "point",
                      "at": "2024-03-01T09:30:00"
                    }
                  ]
                },
                "originDateGranularity": "day",
                "originClockForm": "second",
                "history": {
                  "clamping": "none-declared",
                  "approximation": "approximation-declared"
                }
              }
            }
          },
          "expected": {
            "outcome": "value",
            "value": {
              "temporal": {
                "category": "civilDateTime",
                "value": "2024-03-01T09:30:00"
              },
              "originDateGranularity": "day",
              "originClockForm": "second",
              "history": {
                "clamping": "none-declared",
                "approximation": "approximation-declared"
              }
            },
            "metadata": {
              "evaluation": "exact-for-policy",
              "clamping": "not-applied",
              "effectivePolicy": {
                "profile": "aeonic.operations.temporal.civil-datetime.v1",
                "dateGranularity": "day",
                "clockForm": "second"
              }
            }
          }
        }
      ],
      "links": [
        {

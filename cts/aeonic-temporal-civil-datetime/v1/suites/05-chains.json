                  "category": "finiteNumber",
                  "value": ".5"
                },
                "history": "approximation-declared"
              }
            }
          },
          "expected": {
            "outcome": "value",
            "value": {
              "temporal": {
                "category": "civilDateTimeSet",
                "pieces": [
                  {
                    "kind": "point",
                    "at": "2024-03-01T09:30:00.5"
                  }
                ]
              },
              "originDateGranularity": "day",
              "originClockForm": "second",
              "history": {
                "clamping": "none-declared",
                "approximation": "approximation-declared"

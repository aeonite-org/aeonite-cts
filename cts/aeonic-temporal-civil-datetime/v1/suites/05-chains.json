{
  "id": "05-chains",
  "tests": [
    {
      "id": "clamped-month-chain",
      "kind": "chain",
      "requires": [
        "arithmetic"
      ],
      "steps": [
        {
          "request": {
            "operation": "shift",
            "input": {
              "policy": {
                "profile": "aeonic.operations.temporal.civil-datetime.v1",
                "unit": "month",
                "count": "1"
              },
              "value": {
                "temporal": {
                  "category": "civilDateTime",
                  "value": "2023-01-31T09:30:00"
                }
              }
            }
          },
          "expected": {
            "outcome": "value",
            "value": {
              "temporal": {
                "category": "civilDateTimeSet",
                "pieces": [
                  {
                    "kind": "point",
                    "at": "2023-02-28T09:30:00"
                  }
                ]
              },
              "originDateGranularity": "day",
              "originClockForm": "second",
              "history": {
                "clamping": "clamping-declared",
                "approximation": "none-declared"
              }
            },
            "metadata": {
              "evaluation": "exact-for-policy",
              "clamping": "applied",
              "effectivePolicy": {
                "profile": "aeonic.operations.temporal.civil-datetime.v1",
                "unit": "month",
                "count": "1"
              }
            }
          }
        },
        {
          "request": {
            "operation": "shift",
            "input": {
              "policy": {
                "profile": "aeonic.operations.temporal.civil-datetime.v1",
                "unit": "month",
                "count": "1"
              },
              "value": {
                "temporal": {
                  "category": "civilDateTimeSet",
                  "pieces": [
                    {
                      "kind": "point",
                      "at": "2023-02-28T09:30:00"
                    }
                  ]
                },
                "originDateGranularity": "day",
                "originClockForm": "second",
                "history": {
                  "clamping": "clamping-declared",
                  "approximation": "none-declared"
                }
              }
            }
          },
          "expected": {
            "outcome": "value",
            "value": {
              "temporal": {
                "category": "civilDateTimeSet",
                "pieces": [
                  {
                    "kind": "point",
                    "at": "2023-03-28T09:30:00"
                  }
                ]
              },
              "originDateGranularity": "day",
              "originClockForm": "second",
              "history": {
                "clamping": "clamping-declared",
                "approximation": "none-declared"
              }
            },
            "metadata": {
              "evaluation": "exact-for-policy",
              "clamping": "not-applied",
              "effectivePolicy": {
                "profile": "aeonic.operations.temporal.civil-datetime.v1",
                "unit": "month",
                "count": "1"
              }
            }
          }
        }
      ],
      "links": [
        {
          "fromStep": 0,
          "toStep": 1,
          "input": "value"
        }
      ]
    },
    {
      "id": "clock-history-through-reversal-materialization",
      "kind": "chain",
      "requires": [
        "arithmetic"
      ],
      "steps": [
        {
          "request": {

          }
        }
      },
      "expected": {
        "outcome": "diagnostic",
        "reason": "resource_limit",
        "context": {
          "stage": 7,
          "path": null
        }
      },
      "policy": {
        "resourceLimits": {
          "maxOutputPieces": 28
        }
      }
    },

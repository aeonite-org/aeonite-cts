{
  "id": "07-operand-boundaries",
  "tests": [
    {
      "id": "amount-leading-zero-integer",
      "requires": [
        "arithmetic"
      ],
      "fixture": {
        "request": {
          "operation": "shiftClock",
          "input": {
            "value": {
              "temporal": {
                "category": "civilDateTime",
                "value": "2024-03-01T09:30:00"
              }
            },
            "amount": {
              "number": {
                "category": "finiteNumber",
                "value": "01"
              }
            },
            "policy": {
              "profile": "aeonic.operations.temporal.civil-datetime.v1"
            }
          }
        }
      },
      "expected": {
        "outcome": "diagnostic",
        "reason": "invalid_operand",
        "context": {
          "stage": 4,
          "path": "/input/amount/number/value"
        }
      }
    },

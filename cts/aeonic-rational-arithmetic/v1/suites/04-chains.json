              "number": {
                "category": "finiteNumber",
                "value": "1"
              },
              "history": "none-declared"
            },
            "metadata": {
              "evaluation": "exact-for-operands",
              "effectivePolicy": {
                "profile": "aeonic.operations.arithmetic.rational.v1",
                "family": "integer",
                "zeroSign": "positive"
              }
            }
          }
        }

      "steps": [
        {
          "request": {
            "operation": "divide",
            "input": {
              "left": {
                "number": {
                  "category": "finiteNumber",
                  "value": "1"
                }
              },
              "right": {
                "number": {
                  "category": "finiteNumber",
                  "value": "3"
                }
              },
              "context": {
                "profile": "aeonic.operations.arithmetic.rational.v1"
              }
            }
          },
          "expected": {
            "outcome": "value",
            "value": {
              "number": {
                "category": "exactRational",
                "coefficient": "1",
                "exponent": "0",
                "denominator": "3"
              },
              "history": "none-declared"
            },
            "metadata": {
              "evaluation": "exact-for-operands",
              "effectivePolicy": {
                "profile": "aeonic.operations.arithmetic.rational.v1"
              }
            }
          }
        },
        {
          "request": {
            "operation": "multiply",
            "input": {
              "left": {
                "number": {
                  "category": "exactRational",
                  "coefficient": "1",
                  "exponent": "0",
                  "denominator": "3"
                },
                "history": "none-declared"
              },
              "right": {
                "number": {
                  "category": "finiteNumber",
                  "value": "3"
                }
              },
              "context": {
                "profile": "aeonic.operations.arithmetic.rational.v1"
              }
            }
          },
          "expected": {
            "outcome": "value",
            "value": {
              "number": {
                "category": "exactNumber",
                "coefficient": "1",
                "exponent": "0"
              },
              "history": "none-declared"
            },
            "metadata": {
              "evaluation": "exact-for-operands",
              "effectivePolicy": {
                "profile": "aeonic.operations.arithmetic.rational.v1"
              }
            }
          }
        },
        {
          "request": {
            "operation": "materialize",
            "input": {
              "value": {
                "number": {
                  "category": "exactNumber",
                  "coefficient": "1",
                  "exponent": "0"

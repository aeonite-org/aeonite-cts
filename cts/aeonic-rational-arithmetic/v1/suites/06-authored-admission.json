{
  "id": "06-authored-admission",
  "description": "Ordered authored finite-number admission: type/characters, full grammar, original exponent, normalized coefficient/exponent; all stage-4 failures use the authored value path.",
  "tests": [
    {
      "id": "authored-type-before-character-guard",
      "fixture": {
        "request": {
          "operation": "add",
          "input": {
            "left": {
              "number": {
                "category": "finiteNumber",
                "value": 1
              }
            },
            "right": {
              "number": {
                "category": "finiteNumber",
                "value": "0"
              }
            },
            "context": {
              "profile": "aeonic.operations.arithmetic.rational.v1"
            }
          }
        }
      },
      "policy": {
        "resourceLimits": {
          "maxNumericCharacters": 0
        }
      },
      "expected": {
        "outcome": "diagnostic",
        "reason": "invalid_operand",
        "context": {
          "stage": 4,
          "path": "/input/left/number/value"
        }
      }
    },

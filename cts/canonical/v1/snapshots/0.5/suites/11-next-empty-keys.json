{
  "meta": {
    "suite_id": "next-canonical-empty-keys",
    "lane": "canonical",
    "sut_protocol": "cts.protocol.v1",
    "spec_refs": [
      "aeonite-specs/sources/appendices/v1/appendix-canonical-form.aeon"
    ]
  },
  "id": "next-canonical-empty-keys",
  "title": "Empty Property Keys \u2014 canonical",
  "tests": [
    {
      "id": "canonical-empty-key-root",
      "description": "root",
      "input": {
        "source": "'' = \"\"",
        "mode": "transport"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "canonical_text": "aeon:header = {\n  encoding = \"utf-8\"\n  mode = \"transport\"\n  profile = \"core\"\n  version = \"1.0\"\n}\n\"\" = \"\"\n"
        }
      },
      "tags": [
        "experimental",
        "empty-keys"
      ]
    },
    {
      "id": "canonical-empty-key-ordering",
      "description": "ordering",
      "input": {
        "source": "z = 1\n\"\" = 0\n\" \" = 2",
        "mode": "transport"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "canonical_text": "aeon:header = {\n  encoding = \"utf-8\"\n  mode = \"transport\"\n  profile = \"core\"\n  version = \"1.0\"\n}\n\"\" = 0\n\" \" = 2\nz = 1\n"
        }
      },
      "tags": [
        "experimental",
        "empty-keys"
      ]
    },
    {
      "id": "canonical-empty-key-nested",
      "description": "nested",
      "input": {
        "source": "outer = { \"\" = false }",
        "mode": "transport"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "canonical_text": "aeon:header = {\n  encoding = \"utf-8\"\n  mode = \"transport\"\n  profile = \"core\"\n  version = \"1.0\"\n}\nouter = {\n  \"\" = false\n}\n"
        }
      },
      "tags": [
        "experimental",
        "empty-keys"
      ]
    },
    {
      "id": "canonical-empty-key-clone",
      "description": "clone",
      "input": {
        "source": "\"\" = 1\ncopy = ~$.[\"\"]",
        "mode": "transport"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "canonical_text": "aeon:header = {\n  encoding = \"utf-8\"\n  mode = \"transport\"\n  profile = \"core\"\n  version = \"1.0\"\n}\n\"\" = 1\ncopy = ~[\"\"]\n"
        }
      },
      "tags": [
        "experimental",
        "empty-keys"
      ]
    },
    {
      "id": "canonical-empty-key-pointer",
      "description": "pointer",
      "input": {
        "source": "\"\" = 1\ncopy = ~>$.[\"\"]",
        "mode": "transport"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "canonical_text": "aeon:header = {\n  encoding = \"utf-8\"\n  mode = \"transport\"\n  profile = \"core\"\n  version = \"1.0\"\n}\n\"\" = 1\ncopy = ~>[\"\"]\n"
        }
      },
      "tags": [
        "experimental",
        "empty-keys"
      ]
    },
    {
      "id": "canonical-empty-key-attributes",
      "description": "Empty attribute-entry keys retain their name and canonical scalar key order",
      "input": {
        "source": "value@{z = 0, \"\" = \"meta\"}:string = \"\"",
        "mode": "transport"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "canonical_text": "aeon:header = {\n  encoding = \"utf-8\"\n  mode = \"transport\"\n  profile = \"core\"\n  version = \"1.0\"\n}\nvalue@{\"\" = \"meta\", z = 0}:string = \"\"\n"
        }
      },
      "tags": [
        "experimental",
        "empty-keys"
      ]
    },
    {
      "id": "canonical-empty-key-root-fixed-point",
      "description": "Canonical fixed point: root",
      "input": {
        "source": "aeon:header = {\n  encoding = \"utf-8\"\n  mode = \"transport\"\n  profile = \"core\"\n  version = \"1.0\"\n}\n\"\" = \"\"\n",
        "mode": "transport"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "canonical_text": "aeon:header = {\n  encoding = \"utf-8\"\n  mode = \"transport\"\n  profile = \"core\"\n  version = \"1.0\"\n}\n\"\" = \"\"\n"
        }
      },
      "tags": [
        "experimental",
        "empty-keys"
      ]
    },
    {
      "id": "canonical-empty-key-ordering-fixed-point",
      "description": "Canonical fixed point: ordering",
      "input": {
        "source": "aeon:header = {\n  encoding = \"utf-8\"\n  mode = \"transport\"\n  profile = \"core\"\n  version = \"1.0\"\n}\n\"\" = 0\n\" \" = 2\nz = 1\n",
        "mode": "transport"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "canonical_text": "aeon:header = {\n  encoding = \"utf-8\"\n  mode = \"transport\"\n  profile = \"core\"\n  version = \"1.0\"\n}\n\"\" = 0\n\" \" = 2\nz = 1\n"
        }
      },
      "tags": [
        "experimental",
        "empty-keys"
      ]
    },
    {
      "id": "canonical-empty-key-nested-fixed-point",
      "description": "Canonical fixed point: nested",
      "input": {
        "source": "aeon:header = {\n  encoding = \"utf-8\"\n  mode = \"transport\"\n  profile = \"core\"\n  version = \"1.0\"\n}\nouter = {\n  \"\" = false\n}\n",
        "mode": "transport"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "canonical_text": "aeon:header = {\n  encoding = \"utf-8\"\n  mode = \"transport\"\n  profile = \"core\"\n  version = \"1.0\"\n}\nouter = {\n  \"\" = false\n}\n"
        }
      },
      "tags": [
        "experimental",
        "empty-keys"
      ]
    },
    {
      "id": "canonical-empty-key-clone-fixed-point",
      "description": "Canonical fixed point: clone",
      "input": {
        "source": "aeon:header = {\n  encoding = \"utf-8\"\n  mode = \"transport\"\n  profile = \"core\"\n  version = \"1.0\"\n}\n\"\" = 1\ncopy = ~[\"\"]\n",
        "mode": "transport"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "canonical_text": "aeon:header = {\n  encoding = \"utf-8\"\n  mode = \"transport\"\n  profile = \"core\"\n  version = \"1.0\"\n}\n\"\" = 1\ncopy = ~[\"\"]\n"
        }
      },
      "tags": [
        "experimental",
        "empty-keys"
      ]
    },
    {
      "id": "canonical-empty-key-pointer-fixed-point",
      "description": "Canonical fixed point: pointer",
      "input": {
        "source": "aeon:header = {\n  encoding = \"utf-8\"\n  mode = \"transport\"\n  profile = \"core\"\n  version = \"1.0\"\n}\n\"\" = 1\ncopy = ~>[\"\"]\n",
        "mode": "transport"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "canonical_text": "aeon:header = {\n  encoding = \"utf-8\"\n  mode = \"transport\"\n  profile = \"core\"\n  version = \"1.0\"\n}\n\"\" = 1\ncopy = ~>[\"\"]\n"
        }
      },
      "tags": [
        "experimental",
        "empty-keys"
      ]
    },
    {
      "id": "canonical-empty-key-attributes-fixed-point",
      "description": "Canonical fixed point: Empty attribute-entry keys retain their name and canonical scalar key order",
      "input": {
        "source": "aeon:header = {\n  encoding = \"utf-8\"\n  mode = \"transport\"\n  profile = \"core\"\n  version = \"1.0\"\n}\nvalue@{\"\" = \"meta\", z = 0}:string = \"\"\n",
        "mode": "transport"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "canonical_text": "aeon:header = {\n  encoding = \"utf-8\"\n  mode = \"transport\"\n  profile = \"core\"\n  version = \"1.0\"\n}\nvalue@{\"\" = \"meta\", z = 0}:string = \"\"\n"
        }
      },
      "tags": [
        "experimental",
        "empty-keys"
      ]
    }
  ]
}

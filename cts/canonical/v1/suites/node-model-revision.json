{
  "meta": {
    "lane": "canonical",
    "conformance": {
      "surface": "experimental",
      "experimental_default": "exclude"
    },
    "sut_protocol": "cts.protocol.v1",
    "suite_id": "canonical-node-model-revision",
    "spec_refs": [
      "aeonite-specs/sources/aeon/v1/node-model-revision-candidate.aeon"
    ]
  },
  "id": "canonical-node-model-revision",
  "title": "Canonical Source for Revised Nodes",
  "tests": [
    {
      "id": "node-canonical-empty-node",
      "description": "Both empty spellings canonicalise to the abbreviated node form",
      "input": {
        "source": "<tag()>\n"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "canonical_text": "aeon:header = {\n  encoding = \"utf-8\"\n  mode = \"transport\"\n  profile = \"core\"\n  version = \"1.0\"\n}\n<tag>\n"
        }
      }
    },
    {
      "id": "node-canonical-reference-safe-order",
      "description": "The canonical formatter retains availability of a named node before a clone target",
      "input": {
        "source": "<z()>\na = ~z\n"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "canonical_text": "aeon:header = {\n  encoding = \"utf-8\"\n  mode = \"transport\"\n  profile = \"core\"\n  version = \"1.0\"\n}\n<z>\na = ~z\n"
        }
      }
    }
  ]
}

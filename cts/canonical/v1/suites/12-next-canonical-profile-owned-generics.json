  "id": "next-canonical-profile-owned-generics",
  "title": "Canonical Preservation of Generic Claims",
  "tests": [
    {
      "id": "canonical-profile-generics-reserved-scalar",
      "description": "Preserve generic and numeric clarifier on a scalar.",
      "input": {
        "source": "aeon:header={}\nn:number<string>[9.00]=3"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "canonical_text": "aeon:header = {\n}\nn:number<string>[9.0] = 3\n"
        }
      },
      "tags": [
        "development",
        "generics",
        "profile-admission"
      ]
    },
    {
      "id": "canonical-profile-generics-custom-symbol",
      "description": "Preserve the generic claim and symbolic payload.",
      "input": {
        "source": "aeon:header={}\nr:rational<number>=|1/3|"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "canonical_text": "aeon:header = {\n}\nr:rational<number> = |1/3|\n"
        }
      },
      "tags": [
        "development",
        "generics",
        "profile-admission"
      ]
    },
    {
      "id": "canonical-profile-generics-mixed-symbol",
      "description": "Preserve the generic claim and string clarifier together.",
      "input": {
        "source": "aeon:header={}\nduration:symbol<time>[\"minutes\"] = |1min|"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "canonical_text": "aeon:header = {\n}\nduration:symbol<time>[\"minutes\"] = |1min|\n"
        }
      },
      "tags": [
        "development",
        "generics",
        "profile-admission"
      ]
    }
  ]
}

{
  "meta": {
    "suite_id": "next-canonical-literal-flow",
    "lane": "canonical",
    "sut_protocol": "cts.protocol.v1",
    "spec_refs": [
      "aeonite-specs/sources/aeon/v1/value-types-v1.aeon#number-2",
      "aeonite-specs/sources/aeon/v1/value-types-v1.aeon#string-2",
      "aeonite-specs/sources/aeon/v1/value-types-v1.aeon#trimtick-2"
    ]
  },
  "id": "next-canonical-literal-flow",
  "title": "Next Canonical Literal Flow Regressions",
  "tests": [
    {
      "id": "canonical-literal-flow-001-exponent-leading-zeroes",
      "description": "Valid leading-zero exponents normalize without changing numeric family or value",
      "input": {
        "source": "aeon:mode = \"strict\"\na:number = 1e+01\nb:number = 1e-01\nc:number = 1e01\nd:number = 1e0_1\ne:number = 1e+00\n"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "canonical_text": "aeon:header = {\n  mode = \"strict\"\n}\na:number = 1e1\nb:number = 1e-1\nc:number = 1e1\nd:number = 1e1\ne:number = 1e0\n"
        }
      },
      "tags": [
        "experimental",
        "canonical",
        "literal-flow"
      ]
    },
    {
      "id": "canonical-literal-flow-002-escaped-carriage-return",
      "description": "Escaped carriage returns survive canonicalization from either ordinary quote delimiter",
      "input": {
        "source": "aeon:mode = \"strict\"\na:string = \"a\\rb\"\nb:string = 'a\\rb'\n"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "canonical_text": "aeon:header = {\n  mode = \"strict\"\n}\na:string = \"a\\rb\"\nb:string = \"a\\rb\"\n"
        }
      },
      "tags": [
        "experimental",
        "canonical",
        "literal-flow"
      ]
    },
    {
      "id": "canonical-literal-flow-003-prose-family",
      "description": "Compact prose values retain their required trimtick literal family",
      "input": {
        "source": "aeon:mode = \"strict\"\nv:prose = >`text`\n"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "canonical_text": "aeon:header = {\n  mode = \"strict\"\n}\nv:prose = >`text`\n"
        }
      },
      "tags": [
        "experimental",
        "canonical",
        "literal-flow"
      ]
    },
    {
      "id": "canonical-literal-flow-004-zero-with-nonzero-exponent",
      "description": "Exponent-family zero normalizes to signed 0e0 even when its authored exponent is nonzero",
      "input": {
        "source": "aeon:mode = \"strict\"\na:number = 0e+01\nb:number = 0e-01\nc:number = -0e+01\nd:number = -0e-01\n"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "canonical_text": "aeon:header = {\n  mode = \"strict\"\n}\na:number = 0e0\nb:number = 0e0\nc:number = -0e0\nd:number = -0e0\n"
        }
      },
      "tags": ["experimental", "canonical", "literal-flow", "zero", "negative-zero"]
    },
    {
      "id": "canonical-literal-flow-005-compact-trimtick-leading-blanks",
      "description": "Compact trimtick canonicalization preserves one or more semantic leading blank lines at bindings and inside attributes",
      "input": {
        "source": "aeon:mode = \"strict\"\none:trimtick = >`\n\n\t alpha\n\tbeta\n`\ntwo:trimtick = >`\n\n\n\t alpha\n\tbeta\n`\nitem@{note:trimtick = >`\n\n  alpha\n  beta\n`}:number = 1\n"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "canonical_text": "aeon:header = {\n  mode = \"strict\"\n}\nitem@{note:trimtick = >`\\n\\n alpha\\n beta`}:number = 1\none:trimtick = >`\n  \n   alpha\n  beta\n`\ntwo:trimtick = >`\n  \n  \n   alpha\n  beta\n`\n"
        }
      },
      "tags": ["experimental", "canonical", "literal-flow", "trimtick", "leading-blank-lines", "round-trip"]
    },
    {
      "id": "canonical-literal-flow-006-ordinary-multiline-backtick",
      "description": "An ordinary multiline backtick remains string semantics and canonicalizes to an escaped quoted string rather than a trimtick",
      "input": {
        "source": "aeon:mode = \"strict\"\nvalue = `\nhello\n`\n"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "canonical_text": "aeon:header = {\n  mode = \"strict\"\n}\nvalue = \"\\nhello\\n\"\n"
        }
      },
      "tags": ["experimental", "canonical", "literal-flow", "string", "backtick", "round-trip"]
    },
    {
      "id": "canonical-literal-flow-007-block-trimtick-space-indentation",
      "description": "Block trimticks use canonical space indentation even when the semantic payload begins with a space",
      "input": {
        "source": "aeon:mode = \"strict\"\nc:trimtick=>`\n  hello\n world\n hello\n`\n"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "canonical_text": "aeon:header = {\n  mode = \"strict\"\n}\nc:trimtick = >`\n   hello\n  world\n  hello\n`\n"
        }
      },
      "tags": ["experimental", "canonical", "literal-flow", "trimtick", "indentation", "spaces", "round-trip"]
    },
    {
      "id": "canonical-literal-flow-008-tab-authored-trimtick-space-canonicalization",
      "description": "A tab-gutter-authored block trimtick canonicalizes to expanded space indentation when the payload has no common leading space",
      "input": {
        "source": "aeon:mode = \"strict\"\ndescription:prose = >`\n\tfirst\n\t second\n`"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "canonical_text": "aeon:header = {\n  mode = \"strict\"\n}\ndescription:prose = >`\n  first\n   second\n`\n"
        }
      },
      "tags": ["experimental", "canonical", "literal-flow", "trimtick", "tab-gutter", "spaces", "round-trip"]
    },
    {
      "id": "canonical-literal-flow-009-common-leading-space-protection",
      "description": "Canonicalization uses the compact protective gutter when every nonblank payload line has semantic leading spaces",
      "input": {
        "source": "aeon:mode = \"strict\"\ndescription:prose = >`\n\t first\n\t  second\n`"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "canonical_text": "aeon:header = {\n  mode = \"strict\"\n}\ndescription:prose = >`\\t first\\n\\t  second`\n"
        }
      },
      "tags": ["experimental", "canonical", "literal-flow", "trimtick", "tab-gutter", "leading-space", "round-trip"]
    }
  ]
}

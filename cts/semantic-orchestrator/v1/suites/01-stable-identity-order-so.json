{
  "meta": {
    "suite_id": "stable-identity-order-so",
    "lane": "stable-identity-order-so",
    "capability": "SemanticOrchestrator.StableIdentityOrder",
    "profile": "asp.stable-identity-order.profile.v1",
    "sut_protocol": "cts.protocol.v1",
    "owner": "semantic-orchestrator",
    "description": "Host-neutral negotiation, bounded retry policy, and stable diagnostic classification."
  },
  "id": "stable-identity-order-so",
  "title": "Stable Identity/Order Semantic Orchestrator",
  "tests": [
    {
      "id": "stable-order-so-001-default-remains-asp-v0",
      "tags": ["experimental", "negotiation", "default"],
      "input": { "action": "negotiate", "request": { "namespace": "$.items" } },
      "expected": {
        "ok": true,
        "requestedSubstrate": null,
        "substrate": "asp.v0",
        "profileStatus": "reference-supported"
      }
    },
    {
      "id": "stable-order-so-002-explicit-opt-in",
      "tags": ["experimental", "negotiation", "opt-in"],
      "input": { "action": "negotiate", "request": { "substrate": "asp.stable-identity-order.v1", "namespace": "$.items" } },
      "expected": {
        "ok": true,
        "requestedSubstrate": "asp.stable-identity-order.v1",
        "substrate": "asp.stable-identity-order.v1",
        "profileId": "asp.stable-identity-order.profile.v1",
        "profileStatus": "release-candidate-opt-in"
      }
    },
    {
      "id": "stable-order-so-003-unknown-target-fails-closed",
      "tags": ["experimental", "negotiation", "negative"],
      "input": { "action": "negotiate", "request": { "substrate": "unknown.v1" } },
      "expected": { "ok": false, "diagnosticCodes": ["SEMANTIC_TARGET_SUBSTRATE_UNSUPPORTED"], "phase": "target" }
    },
    {
      "id": "stable-order-so-004-retry-budget-is-bounded",
      "tags": ["experimental", "retry", "negative"],
      "input": { "action": "retry_policy", "retry": { "stalePrecondition": "recompile", "maxAttempts": 6 } },
      "expected": { "valid": false, "maxAttempts": 6, "diagnosticCodes": ["SEMANTIC_RETRY_POLICY_INVALID_MAX_ATTEMPTS"] }
    },
    {
      "id": "stable-order-so-005-stale-insert-is-recompilable",
      "tags": ["experimental", "diagnostic", "insert"],
      "input": { "action": "classify", "operation": "insert_ordered_child", "errorCode": "ORDER_PRECONDITION_STALE" },
      "expected": { "outcome": "stale_recompilable", "phase": "commit" }
    },
    {
      "id": "stable-order-so-006-stale-reorder-is-conflict",
      "tags": ["experimental", "diagnostic", "reorder"],
      "input": { "action": "classify", "operation": "set_order", "errorCode": "SET_ORDER_REVISION_STALE" },
      "expected": { "outcome": "semantic_conflict", "phase": "commit" }
    }
  ]
}

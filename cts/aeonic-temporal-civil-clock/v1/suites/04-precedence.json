  "id": "04-precedence",
  "tests": [
    {
      "id": "nonzero-day-does-not-materialize",
      "requires": [
        "arithmetic"
      ],
      "fixture": {
        "request": {
          "operation": "materialize",
          "input": {
            "context": {
              "profile": "aeonic.operations.temporal.civil-clock.v1"
            },
            "value": {
              "temporal": {
                "category": "civilClockSet",
                "pieces": [
                  {
                    "kind": "point",
                    "at": {
                      "day": "1",
                      "time": "01:30:00"
                    }
                  }
                ]
              },
              "originClockForm": "undeclared",
              "history": "none-declared"
            },
            "policy": {
              "clockForm": "second"
            }
          }
        }
      },
      "expected": {
        "outcome": "diagnostic",
        "reason": "unrepresentable_result",
        "context": {
          "stage": 7,
          "path": null
        }
      }
    },

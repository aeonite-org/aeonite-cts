{
  "id": "07-operand-boundaries",
  "tests": [
    {
      "id": "invalid-derived-day-+1",
      "requires": [
        "arithmetic"
      ],
      "fixture": {
        "request": {
          "operation": "shiftClock",
          "input": {
            "context": {
              "profile": "aeonic.operations.temporal.civil-clock.v1"
            },
            "value": {
              "temporal": {
                "category": "civilClockSet",
                "pieces": [
                  {
                    "kind": "point",
                    "at": {
                      "day": "+1",
                      "time": "01:30:00"
                    }
                  }
                ]
              },
              "originClockForm": "undeclared",
              "history": "none-declared"
            },
            "amount": {
              "number": {
                "category": "finiteNumber",
                "value": "0"
              }
            }
          }
        }
      },
      "expected": {
        "outcome": "diagnostic",
        "reason": "invalid_operand",
        "context": {
          "stage": 4,
          "path": "/input/value/temporal/pieces/0/at/day"
        }
      }
    },

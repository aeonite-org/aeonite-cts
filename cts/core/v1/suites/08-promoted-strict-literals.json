{
  "meta": {
    "suite_id": "promoted-strict-literals",
    "lane": "core",
    "sut_protocol": "cts.protocol.v1",
    "spec_refs": [
      "specs/04-official/v1/value-types-v1.md",
      "specs/04-official/v1/structure-syntax-v1.md"
    ]
  },
  "id": "promoted-strict-literals",
  "title": "Promoted Deterministic Strict Literal Cases",
  "tests": [
    {
      "id": "core-strict-001-time-utc-minutes-accepted",
      "description": "UTC minute-precision time literals remain accepted in strict typed bindings",
      "input": {
        "source": "utcmin:time = 09:30Z\n",
        "mode": "strict"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "parse_ok": true,
          "bindings": [
            {
              "path": "$.utcmin",
              "datatype": "time",
              "kind": "binding"
            }
          ]
        }
      },
      "tags": [
        "strict",
        "time",
        "literals"
      ],
      "spec_refs": [
        "specs/04-official/v1/value-types-v1.md"
      ]
    },
    {
      "id": "core-strict-002-leap-day-date-accepted",
      "description": "Valid leap-day date literals remain accepted in strict typed bindings",
      "input": {
        "source": "good:date = 2024-02-29\n",
        "mode": "strict"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "parse_ok": true,
          "bindings": [
            {
              "path": "$.good",
              "datatype": "date",
              "kind": "binding"
            }
          ]
        }
      },
      "tags": [
        "strict",
        "date",
        "literals"
      ],
      "spec_refs": [
        "specs/04-official/v1/value-types-v1.md"
      ]
    },
    {
      "id": "core-strict-003-offset-datetime-accepted",
      "description": "Offset datetime literals remain accepted in strict typed bindings",
      "input": {
        "source": "dt4:datetime = 2025-01-01T09:30+02:00\n",
        "mode": "strict"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "parse_ok": true,
          "bindings": [
            {
              "path": "$.dt4",
              "datatype": "datetime",
              "kind": "binding"
            }
          ]
        }
      },
      "tags": [
        "strict",
        "datetime",
        "literals"
      ],
      "spec_refs": [
        "specs/04-official/v1/value-types-v1.md"
      ]
    },
    {
      "id": "core-strict-004-local-wtc-accepted",
      "description": "WTC literals accept exact lowercase local as the reserved resolver-local reference",
      "input": {
        "source": "zdt8:wtc = 2025-01-01T09:30Z&local\n",
        "mode": "strict"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "parse_ok": true,
          "bindings": [
            {
              "path": "$.zdt8",
              "datatype": "wtc",
              "kind": "binding"
            }
          ]
        }
      },
      "tags": [
        "strict",
        "wtc",
        "literals"
      ],
      "spec_refs": [
        "specs/04-official/v1/value-types-v1.md"
      ]
    },
    {
      "id": "core-strict-004b-named-wtc-zone-characters-accepted",
      "description": "WTC literals accept common temporal references containing dash and plus characters",
      "input": {
        "source": "z1:wtc = 2025-01-01T09:30Z&America/Port-au-Prince\nz2:wtc = 2025-01-01T09:30Z&GB-Eire\nz3:wtc = 2025-01-01T09:30Z&Etc/GMT-1\nz4:wtc = 2025-01-01T09:30Z&Etc/GMT+1\n",
        "mode": "strict"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "parse_ok": true,
          "bindings": [
            {
              "path": "$.z1",
              "datatype": "wtc",
              "kind": "binding"
            },
            {
              "path": "$.z2",
              "datatype": "wtc",
              "kind": "binding"
            },
            {
              "path": "$.z3",
              "datatype": "wtc",
              "kind": "binding"
            },
            {
              "path": "$.z4",
              "datatype": "wtc",
              "kind": "binding"
            }
          ]
        }
      },
      "tags": [
        "strict",
        "wtc",
        "literals",
        "regression"
      ],
      "spec_refs": [
        "specs/04-official/v1/value-types-v1.md"
      ]
    },
    {
      "id": "core-strict-004c-wtc-anchor-reference-matrix-accepted",
      "description": "WTC literals preserve civil, numeric-offset, and UTC anchors independently across local, named, and geographic references",
      "input": {
        "source": "civilLocal:wtc = 2025-01-01T09:30&local\noffsetLocal:wtc = 2025-01-01T09:30+02:00&local\nutcLocal:wtc = 2025-01-01T07:30Z&local\ncivilNamed:wtc = 2025-01-01T09:30&Australia/Melbourne\noffsetNamed:wtc = 2025-01-01T09:30+11:00&Australia/Melbourne\nutcNamed:wtc = 2024-12-31T22:30Z&Australia/Melbourne\ncivilGeo:wtc = 2035-01-01T09:00&-36.7590183/144.2826718\noffsetGeo:wtc = 2035-01-01T09:00+11:00&-36.7590183/144.2826718/213\nutcGeo:wtc = 2034-12-31T22:00Z&-36.7590183/144.2826718/213\n",
        "mode": "strict"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "parse_ok": true,
          "bindings": [
            { "path": "$.civilLocal", "datatype": "wtc", "kind": "binding" },
            { "path": "$.offsetLocal", "datatype": "wtc", "kind": "binding" },
            { "path": "$.utcLocal", "datatype": "wtc", "kind": "binding" },
            { "path": "$.civilNamed", "datatype": "wtc", "kind": "binding" },
            { "path": "$.offsetNamed", "datatype": "wtc", "kind": "binding" },
            { "path": "$.utcNamed", "datatype": "wtc", "kind": "binding" },
            { "path": "$.civilGeo", "datatype": "wtc", "kind": "binding" },
            { "path": "$.offsetGeo", "datatype": "wtc", "kind": "binding" },
            { "path": "$.utcGeo", "datatype": "wtc", "kind": "binding" }
          ]
        }
      },
      "tags": ["strict", "wtc", "literals", "anchors", "geographic"],
      "spec_refs": [
        "specs/04-official/v1/value-types-v1.md",
        "specification/conventions/aeon-gp-temporal-v1"
      ]
    },
    {
      "id": "core-strict-004d-wtc-local-case-variants-reject",
      "description": "The reserved WTC local reference rejects non-canonical case variants",
      "input": {
        "source": "dt:wtc = 2025-01-01T09:30Z&Local\n",
        "mode": "strict"
      },
      "expected": {
        "ok": false,
        "errors": [
          {
            "code": "INVALID_DATETIME",
            "phaseLabel": "Parsing"
          }
        ],
        "warnings": []
      },
      "tags": ["strict", "wtc", "local", "case", "rejection"],
      "spec_refs": [
        "specs/04-official/v1/value-types-v1.md",
        "specification/conventions/aeon-gp-temporal-v1"
      ]
    },
    {
      "id": "core-strict-004e-wtc-uppercase-local-reject",
      "description": "The reserved WTC local reference rejects the all-uppercase spelling",
      "input": {
        "source": "dt:wtc = 2025-01-01T09:30Z&LOCAL\n",
        "mode": "strict"
      },
      "expected": {
        "ok": false,
        "errors": [
          {
            "code": "INVALID_DATETIME",
            "phaseLabel": "Parsing"
          }
        ],
        "warnings": []
      },
      "tags": ["strict", "wtc", "local", "case", "rejection"],
      "spec_refs": [
        "specs/04-official/v1/value-types-v1.md",
        "specification/conventions/aeon-gp-temporal-v1"
      ]
    },
    {
      "id": "core-strict-005-invalid-time-rejects",
      "description": "Out-of-range time literals reject during parsing",
      "input": {
        "source": "at:time = 24:00\n",
        "mode": "strict"
      },
      "expected": {
        "ok": false,
        "errors": [
          {
            "code": "INVALID_TIME",
            "phaseLabel": "Parsing"
          }
        ],
        "warnings": []
      },
      "tags": [
        "strict",
        "time",
        "rejection"
      ],
      "spec_refs": [
        "specs/04-official/v1/value-types-v1.md"
      ]
    },
    {
      "id": "core-strict-006-invalid-date-rejects",
      "description": "Non-existent calendar dates reject during parsing",
      "input": {
        "source": "bad:date = 2025-02-29\n",
        "mode": "strict"
      },
      "expected": {
        "ok": false,
        "errors": [
          {
            "code": "INVALID_DATE",
            "phaseLabel": "Parsing"
          }
        ],
        "warnings": []
      },
      "tags": [
        "strict",

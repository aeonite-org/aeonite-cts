        "rejection",
        "regression"
      ],
      "spec_refs": [
        "specs/04-official/v1/value-types-v1.md"
      ]
    },
    {
      "id": "core-strict-010-lowercase-temporal-markers-reject",
      "description": "Lowercase datetime marker variants reject as syntax-class errors during parsing",
      "input": {
        "source": "dt:datetime = 2025-01-01t09:30z\n",
        "mode": "strict"
      },
      "expected": {
        "ok": false,
        "errors": [
          {
            "code": "SYNTAX_ERROR",
            "phaseLabel": "Parsing"
          }
        ],
        "warnings": []
      },
      "tags": [
        "strict",
        "datetime",
        "rejection",
        "regression"
      ],
      "spec_refs": [
        "specs/04-official/v1/value-types-v1.md"
      ]
    },
    {
      "id": "core-strict-009-typed-nan-pass",
      "description": "Strict mode accepts typed NaN literals",
      "input": {
        "source": "a:nan = NaN\nb:nan = -NaN\n",
        "mode": "strict"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": []
      },
      "tags": [
        "strict",
        "nan",
        "accept"
      ],
      "spec_refs": [
        "specs/04-official/v1/value-types-v1.md"
      ]
    },
    {
      "id": "core-strict-010-number-rejects-nan-literal",
      "description": "Strict mode rejects NaN literals bound to :number",
      "input": {
        "source": "a:number = NaN\n",
        "mode": "strict"
      },
      "expected": {
        "ok": false,
        "errors": [
          {
            "code": "DATATYPE_LITERAL_MISMATCH",
            "phaseLabel": "Core Validation"
          }
        ],
        "warnings": []
      },
      "tags": [
        "strict",
        "nan",
        "rejection"
      ],
      "spec_refs": [
        "specs/04-official/v1/value-types-v1.md"
      ]
    },
    {
      "id": "core-strict-011-typed-null-pass",
      "description": "Typed null bindings accept reserved and reason-bearing null literals in strict mode",
      "input": {
        "source": "a:null = !none\nb:null = !\"postponed\"\n",
        "mode": "strict"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "parse_ok": true,
          "bindings": [
            {
              "path": "$.a",
              "datatype": "null",
              "kind": "binding"
            },
            {
              "path": "$.b",
              "datatype": "null",
              "kind": "binding"
            }
          ]
        }
      },
      "tags": [
        "strict",
        "null",
        "literals"
      ],
      "spec_refs": [
        "specs/04-official/v1/value-types-v1.md"
      ]
    },
    {
      "id": "core-strict-012-number-rejects-null-datatype-mismatch",
      "description": "Strict typed null bindings reject ordinary numbers as datatype/literal mismatches",
      "input": {
        "source": "a:null = 0\n",
        "mode": "strict"
      },
      "expected": {
        "ok": false,
        "errors": [
          {
            "code": "DATATYPE_LITERAL_MISMATCH"
          }
        ],
        "warnings": []
      },
      "tags": [
        "strict",
        "null",
        "rejection"
      ],
      "spec_refs": [
        "specs/04-official/v1/value-types-v1.md"
      ]
    },
    {
      "id": "core-strict-013-reserved-datatype-clarifiers-preserved",
      "description": "Core preserves datatype clarifiers on reserved datatype labels without assigning profile-specific meaning",
      "input": {
        "source": "a:n[10] = 22\nb:string[333] = \"hello world\"\nr:radix2[4] = %111\n",
        "mode": "strict"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "parse_ok": true,
          "bindings": [
            {
              "path": "$.a",
              "datatype": "n[10]",
              "kind": "binding"
            },
            {
              "path": "$.b",
              "datatype": "string[333]",
              "kind": "binding"
            },
            {
              "path": "$.r",
              "datatype": "radix2[4]",
              "kind": "binding"
            }
          ]
        }
      },
      "tags": [
        "strict",
        "clarifiers",
        "profile-semantics"
      ],
      "spec_refs": [
        "specs/04-official/v1/value-types-v1.md",
        "specs/contracts/contracts-v1.md"
      ]
    },
    {
      "id": "core-strict-014-retired-zrut-datatype-rejects",
      "description": "The retired zrut datatype name is rejected in the strict reserved datatype surface",
      "input": {
        "source": "legacy:zrut = 2025-01-01T09:30Z&Australia/Melbourne\n",
        "mode": "strict",
        "options": {
          "effective_mode": "strict"
        }
      },
      "expected": {
        "ok": false,
        "errors": [
          {
            "code": "CUSTOM_DATATYPE_NOT_ALLOWED"
          }
        ],
        "warnings": []
      },
      "tags": ["strict", "wtc", "legacy-zrut", "reject"],
      "spec_refs": [
        "specs/04-official/v1/value-types-v1.md"
      ]
    }

      ],
      "spec_refs": [
        "specs/04-official/v1/value-types-v1.md"
      ]
    },
    {
      "id": "core-strict-007-invalid-wtc-datetime-rejects",
      "description": "Malformed WTC reference suffixes reject as invalid datetime literals during parsing",
      "input": {
        "source": "dt:wtc = 2025-01-01T09:30Z&/\n",
        "mode": "strict"
      },
      "expected": {
        "ok": false,
        "errors": [
          {
            "code": "INVALID_DATETIME",
            "phaseLabel": "Parsing"
          }
        ],
        "warnings": []
      },
      "tags": [
        "strict",
        "wtc",
        "rejection"
      ],
      "spec_refs": [
        "specs/04-official/v1/value-types-v1.md"
      ]
    },
    {
      "id": "core-strict-008-datatype-literal-mismatch-rejects",
      "description": "Datatype declarations reject incompatible literal classes during core validation",
      "input": {
        "source": "a:number = Infinity\n",
        "mode": "strict"
      },
      "expected": {
        "ok": false,
        "errors": [
          {
            "code": "DATATYPE_LITERAL_MISMATCH",
            "phaseLabel": "Core Validation"
          }
        ],
        "warnings": []
      },
      "tags": [
        "strict",
        "validation",
        "rejection"
      ],
      "spec_refs": [
        "specs/04-official/v1/value-types-v1.md"
      ]
    },
    {
      "id": "core-strict-009-invalid-wtc-zone-punctuation-rejects",
      "description": "Malformed WTC reference suffixes with punctuation reject during parsing",
      "input": {
        "source": "dt:wtc = 2025-01-01T09:30Z&Area/City!\n",
        "mode": "strict"
      },
      "expected": {
        "ok": false,
        "errors": [
          {
            "code": "SYNTAX_ERROR",

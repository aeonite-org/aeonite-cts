  "id": "next-type-only-generics",
  "title": "Type-only Generic Arguments",
  "tests": [
    {
      "id": "core-type-generics-001-reject",
      "description": "Literal generic arguments are invalid in every source type position",
      "input": {
        "source": "x:custom<1>=[0]",
        "mode": "transport"
      },
      "expected": {
        "ok": false,
        "errors": [
          {
            "code": "SYNTAX_ERROR",
            "path": "$",
            "phase": null
          }
        ],
        "warnings": [],
        "result": {
          "parse_ok": false
        }
      },
      "tags": [
        "experimental",
        "generics",
        "syntax",
        "reject"
      ]
    },

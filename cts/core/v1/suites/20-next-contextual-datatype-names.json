  },
  "id": "next-contextual-datatype-names",
  "title": "Contextual Datatype Names",
  "tests": [
    {
      "id": "core-next-datatype-name-001-literal-words-accepted",
      "description": "Literal keyword spellings remain valid identifier names in datatype context",
      "input": {
        "source": "a:yes = yes\nb:no = no\nc:on = on\nd:off = off\ne:true = true\nf:false = false\ng:list<yes> = [yes]\n",
        "mode": "custom"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "parse_ok": true,
          "bindings": [
            {
              "path": "$.a",
              "datatype": "yes",
              "kind": "binding"
            },
            {
              "path": "$.b",
              "datatype": "no",
              "kind": "binding"
            },
            {
              "path": "$.c",
              "datatype": "on",
              "kind": "binding"
            },
            {
              "path": "$.d",
              "datatype": "off",
              "kind": "binding"
            },
            {
              "path": "$.e",
              "datatype": "true",
              "kind": "binding"
            },
            {
              "path": "$.f",
              "datatype": "false",
              "kind": "binding"
            },
            {
              "path": "$.g",
              "datatype": "list<yes>",
              "kind": "binding"
            },
            {
              "path": "$.g[0]",
              "datatype": null,
              "kind": "binding"
            }
          ]
        }
      },
      "tags": [
        "custom",
        "datatype-policy",
        "contextual-keywords"
      ],
      "spec_refs": [
        "specs/04-official/v1/AEON-spec-v1.md#8-behavior-modes-and-datatype-policy",
        "specs/04-official/v1/structure-syntax-v1.md",
        "specs/04-official/v1/value-types-v1.md"
      ]
    }
  ]
}

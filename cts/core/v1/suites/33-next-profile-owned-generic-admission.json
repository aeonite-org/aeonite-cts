  },
  "id": "next-profile-owned-generic-admission",
  "title": "Core Generic Descriptor Admission",
  "tests": [
    {
      "id": "core-generic-admission-strict-symbol",
      "description": "A symbolic value can carry a reserved datatype argument in strict mode.",
      "input": {
        "source": "aeon:mode = \"strict\"\nduration:symbol<time> = |1min|",
        "mode": "strict"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "parse_ok": true,
          "bindings": [
            {
              "path": "$.duration",
              "datatype": "symbol<time>",
              "kind": "binding"
            }
          ]
        }
      },
      "tags": [
        "development",
        "generics",
        "profile-admission"
      ]
    },
    {
      "id": "core-generic-admission-reserved-scalar-mixed",
      "description": "Core preserves generic arguments and clarifiers on the same reserved scalar.",
      "input": {
        "source": "aeon:mode = \"strict\"\nn:number<string>[9] = 3",
        "mode": "strict"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "parse_ok": true,
          "bindings": [
            {
              "path": "$.n",
              "datatype": "number<string>[9]",
              "kind": "binding"
            }
          ]
        }
      },
      "tags": [
        "development",
        "generics",
        "profile-admission"
      ]
    },
    {
      "id": "core-generic-admission-custom-scalar",
      "description": "A custom generic datatype can carry a symbolic scalar when custom labels are permitted.",
      "input": {
        "source": "aeon:mode = \"custom\"\nr:rational<number> = |1/3|",
        "mode": "custom"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "parse_ok": true,
          "bindings": [
            {
              "path": "$.r",
              "datatype": "rational<number>",
              "kind": "binding"
            }
          ]
        }
      },
      "tags": [
        "development",
        "generics",
        "profile-admission"
      ]
    },
    {
      "id": "core-generic-admission-inline-node-mixed",
      "description": "Core preserves arguments and clarifiers on custom node heads.",
      "input": {
        "source": "doc:node = <tag:pair<string>[\"x\"]>",
        "mode": "transport"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "parse_ok": true
        }
      },
      "tags": [
        "development",
        "generics",
        "profile-admission"
      ]
    },
    {
      "id": "core-generic-admission-outer-mismatch",
      "description": "A generic claim does not override the outer datatype's value kind.",
      "input": {
        "source": "aeon:mode = \"strict\"\nn:number<string>[9] = \"3\"",
        "mode": "strict"
      },
      "expected": {
        "ok": false,
        "errors": [
          {
            "code": "DATATYPE_LITERAL_MISMATCH",
            "path": "$.n"
          }
        ],
        "warnings": [],
        "result": {
          "parse_ok": false
        }
      },
      "tags": [
        "development",
        "generics",
        "profile-admission"
      ]
    },
    {
      "id": "core-generic-admission-literal-argument",
      "description": "A numeric value cannot be a generic argument.",
      "input": {
        "source": "mask:radix<16> = %1",
        "mode": "transport"
      },
      "expected": {
        "ok": false,
        "errors": [
          {
            "code": "SYNTAX_ERROR",
            "path": "$"
          }
        ],
        "warnings": [],
        "result": {
          "parse_ok": false
        }
      },
      "tags": [
        "development",
        "generics",
        "profile-admission"
      ]
    },
    {
      "id": "core-generic-admission-depth-limit",
      "description": "The generic depth limit also applies to scalar datatypes.",
      "input": {
        "source": "aeon:mode = \"strict\"\nduration:symbol<list<object<time>>> = |1min|",
        "mode": "strict"
      },
      "expected": {
        "ok": false,
        "errors": [
          {
            "code": "GENERIC_DEPTH_EXCEEDED",
            "path": "$"
          }
        ],
        "warnings": [],
        "result": {
          "parse_ok": false
        }
      },
      "tags": [
        "development",
        "generics",
        "profile-admission"
      ]
    },

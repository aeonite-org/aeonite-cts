      "description": "A datatype tree exceeding max_datatype_components fails closed.",
      "input": { "source": "a:tuple<int, int> = (1, 2)", "options": { "limits": { "structure": { "max_datatype_components": 2 } } } },
      "expected": { "ok": false, "errors": [{ "code": "DATATYPE_COMPONENTS_EXCEEDED" }], "warnings": [], "result": { "parse_ok": false } },
      "tags": ["limits", "max-datatype-components", "one-over"]
    },
    {

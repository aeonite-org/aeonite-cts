      "expected": { "ok": false, "errors": [{ "code": "MAX_STRING_CODEPOINTS_EXCEEDED" }], "warnings": [], "result": { "parse_ok": false } },
      "tags": ["limits", "max-string-codepoints", "one-over"]
    },
    {
      "id": "core-limits-019-key-segment-at-limit",
      "description": "A decoded key segment may equal max_key_segment_codepoints.",

    {
      "id": "core-limits-020-key-segment-one-over",
      "description": "A decoded key segment exceeding max_key_segment_codepoints fails closed.",
      "input": { "source": "ab = 1", "options": { "limits": { "structure": { "max_key_segment_codepoints": 1 } } } },
      "expected": { "ok": false, "errors": [{ "code": "MAX_KEY_SEGMENT_CODEPOINTS_EXCEEDED" }], "warnings": [], "result": { "parse_ok": false } },
      "tags": ["limits", "max-key-segment-codepoints", "one-over"]
    },
    {
      "id": "core-limits-021-list-items-at-limit",
      "description": "A list may equal max_list_items.",
      "input": { "source": "a = [1, 2]", "options": { "limits": { "structure": { "max_list_items": 2 } } } },
      "expected": { "ok": true, "errors": [], "warnings": [], "result": { "parse_ok": true } },

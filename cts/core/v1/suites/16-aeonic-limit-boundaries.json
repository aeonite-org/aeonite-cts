{
  "meta": {
    "suite_id": "aeonic-limit-boundaries",
    "spec_refs": ["aes/limits/altopelago.aeonic-limits.v1"],
    "constraint_primitives": [
      "inclusive_limit",
      "max_attribute_depth",
      "max_generic_depth",
      "max_generic_arguments",
      "max_clarifier_values",
      "max_datatype_components",
      "max_value_nesting_depth",
      "max_path_depth",
      "max_string_codepoints",
      "max_key_segment_codepoints",
      "max_list_items",
      "max_tuple_items",
      "max_path_characters",
      "max_events",
      "max_input_bytes",
      "max_numeric_literal_characters",
      "max_structured_comment_characters"
    ],
    "limits_defaults": {
      "limits_id": "altopelago.aeonic-limits.v1",
      "limits_version": "1.0.0",
      "profile_claims": ["aeon.gp.profile.v1", "aes.complete.v0", "aes.partial.v0"],
      "structure": {
        "max_attribute_depth": 1,
        "max_generic_depth": 1,
        "max_generic_arguments": 32,
        "max_clarifier_values": 1,
        "max_datatype_components": 64,
        "max_value_nesting_depth": 256,
        "max_path_depth": 1024,
        "max_string_codepoints": 1048576,
        "max_key_segment_codepoints": 1024,
        "max_list_items": 65536,
        "max_tuple_items": 65536,
        "max_path_characters": 8192
      },
      "processing": {
        "max_events": 100000,
        "max_reference_depth": 64,
        "max_materialized_weight": 1000000
      },
      "formats": {
        "aeon": {
          "max_input_bytes": 16777216,
          "max_numeric_literal_characters": 1024,
          "max_structured_comment_characters": 1048576
        },
        "telex": {
          "max_input_bytes": 67108864,
          "max_line_bytes": 1048576,
          "max_fields_per_event": 64,
          "max_decoded_payload_bytes": 33554432
        }
      },
      "transport": {
        "max_frame_bytes": 16777216,
        "max_buffer_bytes": 33554432,
        "max_header_bytes": 65536
      }
    }
  },
  "id": "aeonic-limit-boundaries",
  "title": "AEON v1 Aeonic Limit Boundaries",
  "tests": [
    {
      "id": "core-limits-001-input-bytes-at-limit",
      "description": "AEON input may equal max_input_bytes.",
      "input": { "source": "a = 1", "options": { "limits": { "formats": { "aeon": { "max_input_bytes": 5 } } } } },
      "expected": { "ok": true, "errors": [], "warnings": [], "result": { "parse_ok": true } },
      "tags": ["limits", "max-input-bytes", "boundary"]
    },
    {
      "id": "core-limits-002-input-bytes-one-over",
      "description": "AEON input exceeding max_input_bytes fails closed.",
      "input": { "source": "a = 1", "options": { "limits": { "formats": { "aeon": { "max_input_bytes": 4 } } } } },
      "expected": { "ok": false, "errors": [{ "code": "INPUT_SIZE_EXCEEDED" }], "warnings": [], "result": { "parse_ok": false } },
      "tags": ["limits", "max-input-bytes", "one-over"]
    },
    {
      "id": "core-limits-003-attribute-depth-at-limit",
      "description": "Attribute nesting may equal max_attribute_depth.",
      "input": { "source": "a@{b=1}=0", "options": { "limits": { "structure": { "max_attribute_depth": 1 } } } },
      "expected": { "ok": true, "errors": [], "warnings": [], "result": { "parse_ok": true } },
      "tags": ["limits", "max-attribute-depth", "boundary"]
    },
    {
      "id": "core-limits-004-attribute-depth-one-over",
      "description": "Attribute nesting exceeding max_attribute_depth fails closed.",
      "input": { "source": "a@{b=1}=0", "options": { "limits": { "structure": { "max_attribute_depth": 0 } } } },
      "expected": { "ok": false, "errors": [{ "code": "ATTRIBUTE_DEPTH_EXCEEDED" }], "warnings": [], "result": { "parse_ok": false } },
      "tags": ["limits", "max-attribute-depth", "one-over"]
    },
    {
      "id": "core-limits-005-generic-depth-at-limit",
      "description": "Datatype recursion may equal max_generic_depth.",
      "input": { "source": "a:tuple<tuple<int, int>, int> = ((1, 2), 3)", "options": { "limits": { "structure": { "max_generic_depth": 1 } } } },
      "expected": { "ok": true, "errors": [], "warnings": [], "result": { "parse_ok": true } },
      "tags": ["limits", "max-generic-depth", "boundary"]
    },
    {
      "id": "core-limits-006-generic-depth-one-over",
      "description": "Datatype recursion exceeding max_generic_depth fails closed.",
      "input": { "source": "a:tuple<tuple<int, int>, int> = ((1, 2), 3)", "options": { "limits": { "structure": { "max_generic_depth": 0 } } } },
      "expected": { "ok": false, "errors": [{ "code": "GENERIC_DEPTH_EXCEEDED" }], "warnings": [], "result": { "parse_ok": false } },
      "tags": ["limits", "max-generic-depth", "one-over"]
    },
    {
      "id": "core-limits-007-generic-arguments-at-limit",
      "description": "A generic list may equal max_generic_arguments.",
      "input": { "source": "a:tuple<int, int> = (1, 2)", "options": { "limits": { "structure": { "max_generic_arguments": 2 } } } },
      "expected": { "ok": true, "errors": [], "warnings": [], "result": { "parse_ok": true } },
      "tags": ["limits", "max-generic-arguments", "boundary"]
    },
    {
      "id": "core-limits-008-generic-arguments-one-over",
      "description": "A generic list exceeding max_generic_arguments fails closed.",
      "input": { "source": "a:tuple<int, int> = (1, 2)", "options": { "limits": { "structure": { "max_generic_arguments": 1 } } } },
      "expected": { "ok": false, "errors": [{ "code": "GENERIC_ARGUMENTS_EXCEEDED" }], "warnings": [], "result": { "parse_ok": false } },
      "tags": ["limits", "max-generic-arguments", "one-over"]
    },
    {
      "id": "core-limits-009-clarifier-values-at-limit",
      "description": "A clarifier list may equal max_clarifier_values.",
      "input": { "source": "a:csv[\".\", \".\"] = ^one.two", "options": { "limits": { "structure": { "max_clarifier_values": 2 } } } },
      "expected": { "ok": true, "errors": [], "warnings": [], "result": { "parse_ok": true } },
      "tags": ["limits", "max-clarifier-values", "boundary"]
    },
    {
      "id": "core-limits-010-clarifier-values-one-over",
      "description": "A clarifier list exceeding max_clarifier_values fails closed.",
      "input": { "source": "a:csv[\".\", \".\"] = ^one.two", "options": { "limits": { "structure": { "max_clarifier_values": 1 } } } },
      "expected": { "ok": false, "errors": [{ "code": "CLARIFIER_VALUES_EXCEEDED" }], "warnings": [], "result": { "parse_ok": false } },
      "tags": ["limits", "max-clarifier-values", "one-over"]
    },
    {
      "id": "core-limits-011-datatype-components-at-limit",
      "description": "A datatype tree may equal max_datatype_components.",
      "input": { "source": "a:tuple<int, int> = (1, 2)", "options": { "limits": { "structure": { "max_datatype_components": 3 } } } },
      "expected": { "ok": true, "errors": [], "warnings": [], "result": { "parse_ok": true } },
      "tags": ["limits", "max-datatype-components", "boundary"]
    },

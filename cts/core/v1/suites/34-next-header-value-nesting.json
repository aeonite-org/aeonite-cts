          "parse_ok": false
        }
      },
      "tags": [
        "development",
        "limits",
        "max-value-nesting-depth",
        "header"
      ]
    },
    {
      "id": "core-header-depth-body-list-over",
      "description": "The header exemption leaves body value nesting bounded.",
      "input": {
        "source": "aeon:header = { mode = \"transport\" }\nx = [1]",
        "options": {
          "limits": {
            "structure": {
              "max_value_nesting_depth": 0
            }
          }
        }
      },
      "expected": {
        "ok": false,

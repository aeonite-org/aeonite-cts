    },
    {
      "id": "core-header-depth-quoted-key-is-payload",
      "description": "A quoted body key that resembles the header is an ordinary binding.",
      "input": {
        "source": "\"aeon:header\" = {}",
        "options": {
          "limits": {
            "structure": {
              "max_value_nesting_depth": 0
            }
          }
        }
      },
      "expected": {
        "ok": false,
        "errors": [
          {
            "code": "NESTING_DEPTH_EXCEEDED"
          }
        ],

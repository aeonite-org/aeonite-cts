{
  "meta": {
    "suite_id": "next-header-value-nesting",
    "lane": "core",
    "sut_protocol": "cts.protocol.v1",
    "spec_refs": [
      "aeonite-specs/sources/aeon/v1/AEON-v1-compliance.aeon",
      "aes/limits/altopelago.aeonic-limits.v1"
    ],
    "constraint_primitives": [
      "inclusive_limit",
      "max_value_nesting_depth"
    ],
    "limits_defaults": {
      "limits_id": "altopelago.aeonic-limits.v1",
      "limits_version": "1.0.0",
      "profile_claims": [
        "aeon.gp.profile.v1",
        "aes.complete.v1",
        "aes.partial.v1"
      ],
      "structure": {
        "max_attribute_depth": 1,
        "max_generic_depth": 1,
        "max_generic_arguments": 32,
        "max_clarifier_values": 1,
        "max_datatype_components": 64,
        "max_value_nesting_depth": 256,
        "max_path_depth": 1024,
        "max_string_codepoints": 1048576,
        "max_key_segment_codepoints": 1024,
        "max_list_items": 65536,
        "max_tuple_items": 65536,
        "max_path_characters": 8192
      },
      "processing": {
        "max_events": 100000,
        "max_reference_depth": 64,
        "max_materialized_weight": 1000000
      },
      "formats": {
        "aeon": {
          "max_input_bytes": 16777216,
          "max_numeric_literal_characters": 1024,
          "max_structured_comment_characters": 1048576
        },
        "telex": {
          "max_input_bytes": 67108864,
          "max_line_bytes": 1048576,
          "max_fields_per_event": 64,
          "max_decoded_payload_bytes": 33554432
        }
      },
      "transport": {
        "max_frame_bytes": 16777216,
        "max_buffer_bytes": 33554432,
        "max_header_bytes": 65536
      }
    }
  },
  "id": "next-header-value-nesting",
  "title": "Header Field Value Nesting",
  "tests": [
    {
      "id": "core-header-depth-shorthand-scalar-at-zero",
      "description": "A shorthand scalar header field fits at depth zero.",
      "input": {
        "source": "aeon:mode = \"transport\"\nx = 0",
        "options": {
          "limits": {
            "structure": {
              "max_value_nesting_depth": 0
            }
          }
        }
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "parse_ok": true
        }
      },
      "tags": [
        "development",
        "limits",
        "max-value-nesting-depth",
        "header"
      ]
    },
    {
      "id": "core-header-depth-structured-scalar-at-zero",
      "description": "Structured header braces consume no value nesting.",
      "input": {
        "source": "aeon:header = { mode = \"transport\" }\nx = 0",
        "options": {
          "limits": {
            "structure": {
              "max_value_nesting_depth": 0
            }
          }
        }
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "parse_ok": true
        }
      },
      "tags": [
        "development",
        "limits",
        "max-value-nesting-depth",
        "header"
      ]
    },
    {
      "id": "core-header-depth-shorthand-list-at-one",
      "description": "A shorthand header list consumes one level.",
      "input": {
        "source": "aeon:meta = [1]\nx = 0",
        "options": {
          "limits": {
            "structure": {
              "max_value_nesting_depth": 1
            }
          }
        }
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "parse_ok": true
        }
      },
      "tags": [
        "development",
        "limits",
        "max-value-nesting-depth",
        "header"
      ]
    },
    {
      "id": "core-header-depth-structured-list-at-one",
      "description": "A structured header list consumes one level.",
      "input": {
        "source": "aeon:header = { meta = [1] }\nx = 0",
        "options": {
          "limits": {
            "structure": {
              "max_value_nesting_depth": 1
            }
          }
        }
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "parse_ok": true
        }
      },
      "tags": [
        "development",
        "limits",
        "max-value-nesting-depth",
        "header"
      ]
    },
    {
      "id": "core-header-depth-shorthand-list-over",
      "description": "Shorthand header values still enforce the cap.",
      "input": {
        "source": "aeon:meta = [1]\nx = 0",
        "options": {
          "limits": {
            "structure": {
              "max_value_nesting_depth": 0
            }
          }
        }
      },
      "expected": {
        "ok": false,
        "errors": [
          {
            "code": "NESTING_DEPTH_EXCEEDED"
          }
        ],
        "warnings": [],
        "result": {
          "parse_ok": false
        }
      },
      "tags": [
        "development",
        "limits",
        "max-value-nesting-depth",
        "header"
      ]
    },
    {
      "id": "core-header-depth-structured-list-over",
      "description": "Structured header field values still enforce the cap.",
      "input": {
        "source": "aeon:header = { meta = [1] }\nx = 0",
        "options": {
          "limits": {
            "structure": {
              "max_value_nesting_depth": 0
            }
          }
        }
      },
      "expected": {
        "ok": false,
        "errors": [
          {
            "code": "NESTING_DEPTH_EXCEEDED"
          }
        ],
        "warnings": [],

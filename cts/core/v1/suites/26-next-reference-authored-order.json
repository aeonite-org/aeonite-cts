  "id": "next-reference-authored-order",
  "title": "Authored Reference Order Within Payload and Attribute Namespaces",
  "tests": [
    {
      "id": "core-reference-order-001-object-forward",
      "description": "Reference occurrence order: object forward",
      "input": {
        "source": "a = { b = ~a.z, z = 1 }",
        "mode": "transport"
      },
      "expected": {
        "ok": false,
        "errors": [
          {
            "code": "FORWARD_REFERENCE",
            "path": "$",
            "phase": null
          }
        ],
        "warnings": [],
        "result": {
          "parse_ok": false
        }
      },
      "tags": [
        "experimental",
        "references",
        "attributes",
        "authored-order",
        "reject"
      ]
    },

    ]
  },
  "id": "next-literal-flow-regressions",
  "title": "Next Literal Flow Regressions",
  "tests": [
    {
      "id": "core-literal-flow-001-leading-zero-integer",
      "description": "Underscores do not make a leading-zero mantissa valid: 0_1",
      "input": {
        "source": "v = 0_1\n",
        "mode": "transport"
      },
      "expected": {
        "ok": false,
        "errors": [
          {
            "code": "INVALID_NUMBER"
          }
        ],
        "warnings": [],
        "result": {
          "parse_ok": false
        }
      },
      "tags": [
        "experimental",
        "literal-flow",
        "rejection"
      ]
    },
    {
      "id": "core-literal-flow-002-leading-zero-zero",

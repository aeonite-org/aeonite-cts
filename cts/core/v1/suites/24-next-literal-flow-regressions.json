    {
      "id": "core-literal-flow-012-prose-rejects-double-quoted",
      "description": "The reserved prose datatype requires a trimtick literal, not double-quoted content",
      "input": {
        "source": "aeon:mode = \"strict\"\nv:prose = \"text\"\n",
        "mode": "strict"
      },
      "expected": {
        "ok": false,
        "errors": [
          {
            "code": "DATATYPE_LITERAL_MISMATCH"
          }
        ],
        "warnings": [],
        "result": {
          "parse_ok": false
        }
      },
      "tags": [
        "experimental",
        "literal-flow",
        "rejection"
      ]
    },

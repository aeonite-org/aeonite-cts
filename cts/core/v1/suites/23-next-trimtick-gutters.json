{
  "meta": {
    "suite_id": "next-trimtick-gutters",
    "lane": "core",
    "sut_protocol": "cts.protocol.v1",
    "spec_refs": [
      "aeonite-specs/sources/aeon/v1/value-types-v1.aeon#trimtick-2"
    ]
  },
  "id": "next-trimtick-gutters",
  "title": "Next Trimtick Gutter Syntax",
  "tests": [
    {
      "id": "core-trimtick-001-single-marker-space-gutter",
      "description": "A single trimtick marker accepts a ragged space gutter",
      "input": {
        "source": "note = >`\n    first\n  second\n  third\n`\n",
        "mode": "transport"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "parse_ok": true,
          "bindings": [
            { "path": "$.note", "datatype": null, "kind": "binding" }
          ]
        }
      },
      "tags": ["experimental", "strings", "trimticks", "spaces"]
    },
    {
      "id": "core-trimtick-002-tab-gutter",
      "description": "The first nonblank payload line may select an exact tab gutter",
      "input": {
        "source": "note = >`\n\t\tfirst\n\t\t\tsecond\n\t\tthird\n`\n",
        "mode": "transport"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "parse_ok": true,
          "bindings": [
            { "path": "$.note", "datatype": null, "kind": "binding" }
          ]
        }
      },
      "tags": ["experimental", "strings", "trimticks", "tabs"]
    },
    {
      "id": "core-trimtick-003-mixed-gutter-remains-valid",
      "description": "A non-adopted leading whitespace character is payload rather than a syntax error",
      "input": {
        "source": "note = >`\n\tfirst\n second\n\tthird\n`\n",
        "mode": "transport"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "parse_ok": true,
          "bindings": [
            { "path": "$.note", "datatype": null, "kind": "binding" }
          ]
        }
      },
      "tags": ["experimental", "strings", "trimticks", "mixed-whitespace"]
    },
    {
      "id": "core-trimtick-004-repeated-marker-rejects",
      "description": "Width-bearing repeated trimtick markers are no longer valid",
      "input": {
        "source": "note = >>`value`\n",
        "mode": "transport"
      },
      "expected": {
        "ok": false,
        "errors": [
          { "code": "SYNTAX_ERROR", "path": "$" }
        ],
        "warnings": [],
        "result": {}
      },
      "tags": ["experimental", "strings", "trimticks", "reject"]
    }
  ]
}

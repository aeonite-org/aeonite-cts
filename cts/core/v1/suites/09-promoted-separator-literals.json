{
  "meta": {
    "suite_id": "promoted-separator-literals",
    "lane": "core",
    "sut_protocol": "cts.protocol.v1",
    "spec_refs": [
      "specs/04-official/v1/value-types-v1.md",
      "specs/04-official/v1/structure-syntax-v1.md"
    ]
  },
  "id": "promoted-separator-literals",
  "title": "Promoted Deterministic Separator Literal Cases",
  "tests": [
    {
      "id": "core-sep-001-raw-whitelist-payload-accepted",
      "description": "Separator literals accept raw payloads built only from the separator raw-character whitelist",
      "input": {
        "source": "size:sep[\"x\"] = ^300x250\n",
        "mode": "strict"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "parse_ok": true,
          "bindings": [
            {
              "path": "$.size",
              "datatype": "sep[\"x\"]",
              "kind": "binding"
            }
          ]
        }
      },
      "tags": [
        "strict",
        "separator",
        "literals"
      ],
      "spec_refs": [
        "specs/04-official/v1/value-types-v1.md"
      ]
    },
    {
      "id": "core-sep-002-quoted-segments-accepted",
      "description": "Separator literals accept ordinary quoted string segments for payload content that falls outside the raw whitelist",
      "input": {
        "source": "parts:sep[\"|\"] = ^\"hello world\"|\"this, [is] fine\"\n",
        "mode": "strict"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "parse_ok": true,
          "bindings": [
            {
              "path": "$.parts",
              "datatype": "sep[\"|\"]",
              "kind": "binding"
            }
          ]
        }
      },
      "tags": [
        "strict",
        "separator",
        "literals"
      ],
      "spec_refs": [
        "specs/04-official/v1/value-types-v1.md"
      ]
    },
    {
      "id": "core-sep-003-raw-slash-payload-rejects",
      "description": "Raw separator payloads reject slash characters unless they appear inside quoted segments",
      "input": {
        "source": "file:sep[\"|\"] = ^root/main/file.aeon\n",
        "mode": "strict"
      },
      "expected": {
        "ok": false,
        "errors": [
          {
            "code": "SYNTAX_ERROR"
          }
        ],
        "warnings": []
      },
      "tags": [
        "strict",
        "separator",
        "rejection"
      ],
      "spec_refs": [
        "specs/04-official/v1/value-types-v1.md"
      ]
    },
    {
      "id": "core-sep-004-raw-comma-payload-rejects",
      "description": "Raw separator payloads reject comma characters unless they appear inside quoted segments",
      "input": {
        "source": "coords:sep[\"|\"] = ^1,2,3\n",
        "mode": "strict"
      },
      "expected": {
        "ok": false,
        "errors": [
          {
            "code": "SYNTAX_ERROR"
          }
        ],
        "warnings": []
      },
      "tags": [
        "strict",
        "separator",
        "rejection"
      ],
      "spec_refs": [
        "specs/04-official/v1/value-types-v1.md"
      ]
    },
    {
      "id": "core-sep-005-unparameterized-sep-accepts-caret-literal",
      "description": "Unparameterized sep datatypes may bind separator literals without an explicit bracket spec",
      "input": {
        "source": "blue:sep = ^200\n",
        "mode": "strict"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "parse_ok": true,
          "bindings": [
            {
              "path": "$.blue",
              "datatype": "sep",
              "kind": "binding"
            }
          ]
        }
      },
      "tags": [
        "strict",
        "separator",
        "literals"
      ],
      "spec_refs": [
        "specs/04-official/v1/value-types-v1.md"
      ]
    },
    {
      "id": "core-sep-005b-unparameterized-kadot-accepts-dot-number-literal",
      "description": "Unparameterized kadot datatypes may bind separator literals; kadot payload shape is not enforced by Core",
      "input": {
        "source": "semver:kadot = ^3.14.15\n",
        "mode": "strict"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "parse_ok": true,
          "bindings": [
            {
              "path": "$.semver",
              "datatype": "kadot",
              "kind": "binding"
            }
          ]
        }
      },
      "tags": [
        "strict",
        "separator",
        "literals",
        "kadot"
      ],
      "spec_refs": [
        "specs/04-official/v1/value-types-v1.md"
      ]
    },
    {
      "id": "core-sep-005c-removed-set-alias-rejects-in-strict-mode",
      "description": "Strict mode treats the removed separator alias set as a custom datatype",
      "input": {
        "source": "aeon:mode = \"strict\"\nversion:set = ^1.2.3\n",
        "mode": "strict",
        "options": {
          "datatype_policy": "reserved_only"
        }
      },
      "expected": {
        "ok": false,
        "errors": [
          {
            "code": "CUSTOM_DATATYPE_NOT_ALLOWED"
          }
        ],
        "warnings": []
      },
      "tags": [
        "strict",
        "separator",
        "literals",
        "reject"
      ],
      "spec_refs": [
        "specs/04-official/v1/value-types-v1.md"
      ]
    },
    {
      "id": "core-sep-006-separator-datatype-rejects-list-node",
      "description": "A sep-typed binding rejects list literals even when the list contains a separator literal",
      "input": {
        "source": "filex:sep[\"|\"] = [^\"root/main/file.aeon\"]\n",
        "mode": "strict"
      },
      "expected": {
        "ok": false,
        "errors": [
          {
            "code": "DATATYPE_LITERAL_MISMATCH",
            "phaseLabel": "Core Validation"
          }
        ],
        "warnings": []
      },
      "tags": [
        "strict",
        "separator",
        "validation",
        "rejection"
      ],
      "spec_refs": [
        "specs/04-official/v1/value-types-v1.md"
      ]
    },
    {
      "id": "core-sep-007-unterminated-quoted-segment-rejects",
      "description": "Separator literals reject quoted payload segments that do not terminate before the line ends",
      "input": {
        "source": "bad:sep[\"|\"] = ^\"hello\n",
        "mode": "strict"
      },
      "expected": {
        "ok": false,
        "errors": [
          {
            "code": "UNTERMINATED_STRING"
          }
        ],
        "warnings": []
      },
      "tags": [
        "strict",
        "separator",
        "rejection"
      ],
      "spec_refs": [
        "specs/04-official/v1/value-types-v1.md",
        "specs/04-official/v1/structure-syntax-v1.md"
      ]
    },
    {
      "id": "core-sep-008-angle-and-caret-separator-specs-accepted",
      "description": "Reserved sep datatypes accept bracket specs drawn from the explicit separator whitelist, including <, >, and ^",
      "input": {
        "source": "left:sep[\"<\"] = ^a<b\nright:sep[\">\"] = ^a>b\nup:sep[\"^\"] = ^a^b\n",
        "mode": "strict"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "parse_ok": true,
          "bindings": [
            {
              "path": "$.left",
              "datatype": "sep[\"<\"]",
              "kind": "binding"
            },
            {
              "path": "$.right",
              "datatype": "sep[\">\"]",
              "kind": "binding"
            },
            {
              "path": "$.up",
              "datatype": "sep[\"^\"]",
              "kind": "binding"
            }
          ]
        }
      },
      "tags": [
        "strict",
        "separator",
        "literals"
      ],
      "spec_refs": [
        "specs/04-official/v1/value-types-v1.md",
        "specs/04-official/v1/structure-syntax-v1.md"
      ]
    },
    {
      "id": "core-sep-009-unquoted-separator-clarifier-rejects",
      "description": "Reserved separator datatypes reject old unquoted separator clarifier syntax",
      "input": {
        "source": "bad:sep[/] = ^root/main\n",
        "mode": "strict"
      },
      "expected": {
        "ok": false,
        "errors": [
          {
            "code": "SYNTAX_ERROR"
          }
        ],
        "warnings": []
      },
      "tags": [
        "strict",
        "separator",
        "rejection"
      ],
      "spec_refs": [
        "specs/04-official/v1/value-types-v1.md",
        "specs/04-official/v1/structure-syntax-v1.md"
      ]
    },
    {
      "id": "core-sep-010-inline-boundary-collision-rejects",
      "description": "Inline separator-literal boundary collisions fail closed with deterministic syntax or depth errors",
      "input": {
        "source": "badInline1 = [ ^0,0 , 0,1 ]\nbadInline2 = [ ^0,0,0,1 ]\nbadInline3 = [ ^300x250 ]\nbadSepType1:matrix[\",\", \";\"] = ^1,2,3;4,5,6\nbadSepType2:sep[,] = ^0,0,0,\n",
        "mode": "strict"
      },
      "expected": {
        "ok": false,
        "errors": [
          {
            "code": "SEPARATOR_DEPTH_EXCEEDED"
          },
          {
            "code": "SYNTAX_ERROR"
          }
        ],
        "warnings": []
      },
      "tags": [
        "strict",
        "separator",
        "rejection",
        "boundaries"
      ],
      "spec_refs": [
        "specs/04-official/v1/value-types-v1.md",
        "specs/04-official/v1/structure-syntax-v1.md",
        "specs/04-official/v1/appendices/appendix-error-model.md"
      ]
    }
  ]
}

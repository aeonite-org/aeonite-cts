{
  "meta": {
    "suite_id": "next-empty-keys",
    "lane": "core",
    "sut_protocol": "cts.protocol.v1",
    "spec_refs": [
      "aeonite-specs/sources/aeon/v1/structure-syntax-v1.aeon#keys",
      "aeonite-specs/sources/aeon/v1/addressing-references-v1.aeon"
    ]
  },
  "id": "next-empty-keys",
  "title": "Empty Property Keys \u2014 core",
  "tests": [
    {
      "id": "core-empty-key-root-double",
      "description": "root double",
      "input": {
        "source": "\"\" = \"\"",
        "mode": "transport"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "parse_ok": true,
          "bindings": [
            {
              "path": "$.[\"\"]",
              "datatype": null,
              "kind": "binding"
            }
          ]
        }
      },
      "tags": [
        "experimental",
        "empty-keys"
      ]
    },
    {
      "id": "core-empty-key-root-single",
      "description": "root single",
      "input": {
        "source": "'' = ''",
        "mode": "transport"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "parse_ok": true,
          "bindings": [
            {
              "path": "$.[\"\"]",
              "datatype": null,
              "kind": "binding"
            }
          ]
        }
      },
      "tags": [
        "experimental",
        "empty-keys"
      ]
    },
    {
      "id": "core-empty-key-structural-identity",
      "description": "An empty property name remains a named binding when structural identity metadata is attached",
      "input": {
        "source": "\"\"\\EMPTY\\:string = \"\"",
        "mode": "transport"
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "parse_ok": true,
          "bindings": [
            {
              "path": "$.[\"\"]",
              "datatype": "string",
              "kind": "binding"
            }
          ]
        }
      },
      "tags": [
        "experimental",
        "empty-keys"
      ]
    },
    {
      "id": "core-empty-key-nested",
      "description": "nested",
      "input": {
        "source": "outer = { \"\" = { \"\" = false } }",
        "mode": "transport"
      },
      "expected": {
        "ok": true,
        "errors": [],

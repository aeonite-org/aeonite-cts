{
  "meta": {
    "suite_id": "finalization-limit-boundaries",
    "spec_refs": ["aes/limits/altopelago.aeonic-limits.v1"],
    "constraint_primitives": [
      "inclusive_limit",
      "max_reference_depth",
      "max_materialized_weight"
    ],
    "limits_defaults": {
      "limits_id": "altopelago.aeonic-limits.v1",
      "limits_version": "1.0.0",
      "profile_claims": ["aeon.gp.profile.v1", "aes.complete.v0", "aes.partial.v0"],
      "structure": {
        "max_attribute_depth": 1,
        "max_generic_depth": 1,
        "max_generic_arguments": 32,
        "max_clarifier_values": 1,
        "max_datatype_components": 64,
        "max_value_nesting_depth": 256,
        "max_path_depth": 1024,
        "max_string_codepoints": 1048576,
        "max_key_segment_codepoints": 1024,
        "max_list_items": 65536,
        "max_tuple_items": 65536,
        "max_path_characters": 8192
      },
      "processing": {
        "max_events": 100000,
        "max_reference_depth": 64,
        "max_materialized_weight": 1000000
      },
      "formats": {
        "aeon": {
          "max_input_bytes": 16777216,
          "max_numeric_literal_characters": 1024,
          "max_structured_comment_characters": 1048576
        },
        "telex": {
          "max_input_bytes": 67108864,
          "max_line_bytes": 1048576,
          "max_fields_per_event": 64,
          "max_decoded_payload_bytes": 33554432
        }
      },
      "transport": {
        "max_frame_bytes": 16777216,
        "max_buffer_bytes": 33554432,
        "max_header_bytes": 65536
      }
    }
  },
  "id": "finalization-limit-boundaries",
  "title": "AEON v1 Finalization Limit Boundaries",
  "tests": [
    {
      "id": "finalize-limits-001-materialized-weight-at-limit",
      "description": "Cumulative clone materialization weight may equal max_materialized_weight.",
      "input": {
        "source": "big = { a = 1, b = 2, c = 3 }\ncopy = ~big",
        "options": {
          "effective_mode": "transport",
          "limits": { "processing": { "max_materialized_weight": 3 } }
        }
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "document": {
            "big": { "a": 1, "b": 2, "c": 3 },
            "copy": { "a": 1, "b": 2, "c": 3 }
          }
        }
      },
      "tags": ["limits", "max-materialized-weight", "boundary"]
    },
    {
      "id": "finalize-limits-002-materialized-weight-one-over",
      "description": "Clone materialization exceeding max_materialized_weight fails closed.",
      "input": {
        "source": "big = { a = 1, b = 2, c = 3 }\ncopy = ~big",
        "options": {
          "effective_mode": "transport",
          "limits": { "processing": { "max_materialized_weight": 2 } }
        }
      },
      "expected": {
        "ok": false,
        "errors": [{ "code": "FINALIZE_REFERENCE_BUDGET_EXCEEDED", "path": "$.copy" }],
        "warnings": [],
        "result": {
          "document": {
            "big": { "a": 1, "b": 2, "c": 3 },
            "copy": "~big"
          }
        }
      },
      "tags": ["limits", "max-materialized-weight", "one-over"]
    },
    {
      "id": "finalize-limits-003-reference-depth-at-limit",
      "description": "Clone reference depth may equal max_reference_depth.",
      "input": {
        "source": "base = { a = 1, b = 2 }\ncopy1 = ~base\ncopy2 = ~copy1",
        "options": {
          "effective_mode": "transport",
          "limits": { "processing": { "max_reference_depth": 2 } }
        }
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "document": {
            "base": { "a": 1, "b": 2 },
            "copy1": { "a": 1, "b": 2 },
            "copy2": { "a": 1, "b": 2 }
          }
        }
      },
      "tags": ["limits", "max-reference-depth", "boundary"]
    },
    {
      "id": "finalize-limits-004-reference-depth-one-over",
      "description": "Clone reference depth exceeding max_reference_depth fails closed.",
      "input": {
        "source": "base = { a = 1, b = 2 }\ncopy1 = ~base\ncopy2 = ~copy1",
        "options": {
          "effective_mode": "transport",
          "limits": { "processing": { "max_reference_depth": 1 } }
        }
      },
      "expected": {
        "ok": false,
        "errors": [{ "code": "FINALIZE_REFERENCE_DEPTH_EXCEEDED", "path": "$.copy2" }],
        "warnings": [],
        "result": {
          "document": {
            "base": { "a": 1, "b": 2 },
            "copy1": { "a": 1, "b": 2 },
            "copy2": "~base"
          }
        }
      },
      "tags": ["limits", "max-reference-depth", "one-over"]
    }
  ]
}

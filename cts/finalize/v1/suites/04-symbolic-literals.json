  "id": "finalize-json-symbolic-literals",
  "title": "Finalize JSON Symbol Compatibility Policy",
  "tests": [
    {
      "id": "finalize-symbol-001-strict-errors",
      "description": "Strict JSON materialization reports loss of the symbol value kind",
      "input": {
        "source": "stage:symbol = |in review|\n",
        "mode": "strict",
        "options": { "effective_mode": "strict", "scope": "payload", "materialization": "all" }
      },
      "expected": {
        "ok": false,
        "errors": [{ "code": "FINALIZE_JSON_PROFILE_SYMBOL", "path": "$.stage", "phaseLabel": "Finalization" }],
        "warnings": [],
        "result": { "document": { "stage": "in review" } }
      },
      "tags": ["experimental", "finalize", "json", "symbol", "strict"]
    },
    {
      "id": "finalize-symbol-002-transport-warns",
      "description": "Loose JSON materialization emits the decoded payload and warns about symbol loss",
      "input": {
        "source": "stage = |in review|\n",
        "mode": "transport",
        "options": { "effective_mode": "transport", "scope": "payload", "materialization": "all" }
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [{ "code": "FINALIZE_JSON_PROFILE_SYMBOL", "path": "$.stage", "phaseLabel": "Finalization" }],
        "result": { "document": { "stage": "in review" } }
      },
      "tags": ["experimental", "finalize", "json", "symbol", "transport", "warning"]
    }
  ]
}

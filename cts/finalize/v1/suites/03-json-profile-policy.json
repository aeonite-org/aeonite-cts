{
  "meta": {
    "suite_id": "finalize-json-profile-policy",
    "lane": "finalize-json",
    "sut_protocol": "cts.protocol.v1",
    "spec_refs": [
      "specs/04-official/v1/value-types-v1.md",
      "specs/04-official/v1/appendices/appendix-json-profile.md"
    ]
  },
  "id": "finalize-json-profile-policy",
  "title": "Finalize JSON Compatibility Policy",
  "tests": [
    {
      "id": "finalize-json-policy-001-custom-infinity-fails-strict-json",
      "description": "Allowing a custom datatype label does not weaken strict JSON representability checks for its Infinity literal",
      "input": {
        "source": "n:Infinity = Infinity\n",
        "mode": "custom",
        "options": {
          "effective_mode": "strict",
          "datatype_policy": "allow_custom",
          "scope": "payload",
          "materialization": "all"
        }
      },
      "expected": {
        "ok": false,
        "errors": [
          {
            "code": "FINALIZE_JSON_PROFILE_INFINITY",
            "path": "$.n",
            "phaseLabel": "Finalization"
          }
        ],
        "warnings": [],
        "result": {
          "document": {
            "n": "Infinity"
          }
        }
      },
      "tags": [
        "finalize",
        "json",
        "custom",
        "infinity",
        "profile"
      ],
      "spec_refs": [
        "specs/04-official/v1/value-types-v1.md",
        "specs/04-official/v1/appendices/appendix-json-profile.md"
      ]
    },
    {
      "id": "finalize-json-policy-002-transport-infinity-warns",
      "description": "Transport-mode JSON preserves Infinity as a string and reports the compatibility loss as a warning",
      "input": {
        "source": "limit:infinity = Infinity\n",
        "mode": "transport",
        "options": {
          "effective_mode": "transport",
          "scope": "payload",
          "materialization": "all"
        }
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [
          {
            "code": "FINALIZE_JSON_PROFILE_INFINITY",
            "path": "$.limit",
            "phaseLabel": "Finalization"
          }
        ],
        "result": {
          "document": {
            "limit": "Infinity"
          }
        }
      },
      "tags": [
        "finalize",
        "json",
        "transport",
        "infinity",
        "warning"
      ],
      "spec_refs": [
        "specs/04-official/v1/value-types-v1.md",
        "specs/04-official/v1/appendices/appendix-json-profile.md"
      ]
    },
    {
      "id": "finalize-json-policy-003-transport-nan-warns",
      "description": "Transport-mode JSON preserves NaN as a string and reports the compatibility loss as a warning",
      "input": {
        "source": "limit:nan = NaN\n",
        "mode": "transport",
        "options": {
          "effective_mode": "transport",
          "scope": "payload",
          "materialization": "all"
        }
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [
          {
            "code": "FINALIZE_JSON_PROFILE_NAN",
            "path": "$.limit",
            "phaseLabel": "Finalization"
          }
        ],
        "result": {
          "document": {
            "limit": "NaN"
          }
        }
      },
      "tags": [
        "finalize",
        "json",
        "transport",
        "nan",
        "warning"
      ],
      "spec_refs": [
        "specs/04-official/v1/value-types-v1.md",
        "specs/04-official/v1/appendices/appendix-json-profile.md"
      ]
    },
    {
      "id": "finalize-json-policy-004-transport-reasoned-null-warns",
      "description": "Transport-mode JSON preserves a reasoned null lexeme and reports the compatibility loss as a warning",
      "input": {
        "source": "limit:null = !\"postponed\"\n",
        "mode": "transport",
        "options": {
          "effective_mode": "transport",
          "scope": "payload",
          "materialization": "all"
        }
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [
          {
            "code": "FINALIZE_JSON_PROFILE_NULL",
            "path": "$.limit",
            "phaseLabel": "Finalization"
          }
        ],
        "result": {
          "document": {
            "limit": "!\"postponed\""
          }
        }
      },
      "tags": [
        "finalize",
        "json",
        "transport",
        "null",
        "warning"
      ],
      "spec_refs": [
        "specs/04-official/v1/value-types-v1.md",
        "specs/04-official/v1/appendices/appendix-json-profile.md"
      ]
    },
    {
      "id": "finalize-json-policy-005-transport-unsafe-number-warns",
      "description": "Transport-mode JSON preserves an unsafe number lexeme and reports the compatibility loss as a warning",
      "input": {
        "source": "n:number = 9007199254740993.0\n",
        "mode": "transport",
        "options": {
          "effective_mode": "transport",
          "scope": "payload",
          "materialization": "all"
        }
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [
          {
            "code": "FINALIZE_UNSAFE_NUMBER",
            "path": "$.n",
            "phaseLabel": "Finalization"
          }
        ],
        "result": {
          "document": {
            "n": "9007199254740993.0"
          }
        }
      },
      "tags": [

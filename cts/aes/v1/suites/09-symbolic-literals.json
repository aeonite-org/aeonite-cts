  "id": "symbolic-literals",
  "title": "Portable AES Symbolic Literal Projection",
  "tests": [
    {
      "id": "aes-symbol-001-decoded-payload",
      "description": "Portable AES carries the decoded symbol payload without source delimiters or escape spelling",
      "input": {
        "source": "stage = |this has \\| spaces|\n",
        "mode": "transport",
        "options": { "portable_aes": true }
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "events": [
            { "path": "$.stage", "value_kind": "SymbolicLiteral", "value": "this has | spaces" }
          ]
        }
      },
      "tags": ["experimental", "portable-aes", "symbol", "decoded-payload"]
    }
  ]
}

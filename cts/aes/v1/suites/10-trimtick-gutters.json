{
  "meta": {
    "suite_id": "trimtick-gutters",
    "lane": "aes",
    "profile": "aes.complete.v1",
    "sut_protocol": "cts.protocol.v1",
    "spec_refs": [
      "aeonite-specs/sources/aeon/v1/value-types-v1.aeon#trimtick-2"
    ]
  },
  "id": "trimtick-gutters",
  "title": "Trimtick Gutter Normalization",
  "tests": [
    {
      "id": "aes-trimtick-001-exact-gutter-values",
      "description": "Space, tab, mixed, and inline trimticks expose their exact normalized string payloads",
      "input": {
        "source": "spaces = >`\n    first\n  second\n  third\n`\ntabs = >`\n\t\tfirst\n\t\t\tsecond\n\t\tthird\n`\nmixed = >`\n\tfirst\n second\n\tthird\n`\ninline = >`first\n\tsecond\n`\n",
        "mode": "transport",
        "options": { "portable_aes": true }
      },
      "expected": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "result": {
          "events": [
            { "path": "$.spaces", "value_kind": "StringLiteral", "value": "  first\nsecond\nthird" },
            { "path": "$.tabs", "value_kind": "StringLiteral", "value": "first\n\tsecond\nthird" },
            { "path": "$.mixed", "value_kind": "StringLiteral", "value": "\tfirst\n second\n\tthird" },
            { "path": "$.inline", "value_kind": "StringLiteral", "value": "first\n\tsecond" }
          ]
        }
      },
      "tags": ["experimental", "strings", "trimticks", "canonical-payloads"]
    }
  ]
}

{
  "meta": {
    "suite_id": "stable-identity-order-durability",
    "lane": "stable-identity-order-durability",
    "capability": "AES-DB.StableIdentityOrderDurability",
    "profile": "aes-db.stable-identity-order.record.v1",
    "sut_protocol": "cts.protocol.v1",
    "owner": "aes-db",
    "description": "Canonical record bytes, causal replay, recoverable trailing frames, and fail-closed committed corruption."
  },
  "id": "stable-identity-order-durability",
  "title": "AES-DB Stable Identity/Order Durability",
  "tests": [
    {
      "id": "stable-order-durability-001-canonical-replay",
      "tags": ["experimental", "codec", "replay"],
      "input": { "action": "canonical_replay" },
      "expected": {
        "codecRoundTrip": true,
        "logHeader": "AESDB-SIO 1",
        "documentRevision": 6,
        "materialRevision": 0,
        "childStructuralIds": ["I1", "I0"],
        "transactionIds": ["tx:cts-order"]
      }
    },
    {
      "id": "stable-order-durability-002-torn-tail-recovery",
      "tags": ["experimental", "recovery", "torn-write"],
      "input": { "action": "torn_tail" },
      "expected": {
        "inspectionOk": true,
        "recordCount": 1,
        "diagnosticCode": "TRUNCATED_FRAME",
        "recoverable": true,
        "documentRevision": 5,
        "childStructuralIds": ["I0", "I1"]
      }
    },
    {
      "id": "stable-order-durability-003-checksum-fails-closed",
      "tags": ["experimental", "checksum", "negative"],
      "input": { "action": "checksum_corruption" },
      "expected": { "inspectionOk": false, "diagnosticCode": "CHECKSUM_MISMATCH", "recoverable": false }
    },
    {
      "id": "stable-order-durability-004-causal-gap-rejected",
      "tags": ["experimental", "causality", "negative"],
      "input": { "action": "causal_gap" },
      "expected": { "ok": false, "errorCodes": ["AES_DB_STABLE_ORDER_DOCUMENT_REVISION_GAP"] }
    }
  ]
}

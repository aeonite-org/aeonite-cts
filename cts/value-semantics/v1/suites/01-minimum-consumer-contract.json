{
  "meta": {
    "suite_id": "minimum-consumer-contract",
    "lane": "value-semantics",
    "capability": "AEON.ValueSemantics",
    "profile": "minimum-consumer",
    "sut_protocol": "cts.protocol.v1",
    "spec_refs": [
      "aeonite-specs/aeon/v1/proposals/value-semantics-v1.md#7-minimum-v1-consumer-contract"
    ],
    "description": "Minimum shared value behavior for equality, ordering, and concrete value predicates."
  },
  "id": "minimum-consumer-contract",
  "title": "Shared AEON Value Semantics Minimum Consumer Contract",
  "tests": [
    {
      "id": "value_semantics_001_finite_number_equality_true",
      "description": "Finite numbers compare equal by numeric value.",
      "operation": "equal",
      "input": {
        "left": { "category": "finiteNumber", "value": "42" },
        "right": { "category": "finiteNumber", "value": "42" }
      },
      "expected": { "outcome": "value", "value": true }
    },
    {
      "id": "value_semantics_002_finite_number_equality_false",
      "description": "Different finite numbers compare unequal by numeric value.",
      "operation": "equal",
      "input": {
        "left": { "category": "finiteNumber", "value": "42" },
        "right": { "category": "finiteNumber", "value": "43" }
      },
      "expected": { "outcome": "value", "value": false }
    },
    {
      "id": "value_semantics_003_infinity_same_equality_true",
      "description": "Positive infinity equals positive infinity.",
      "operation": "equal",
      "input": {
        "left": { "category": "positiveInfinity" },
        "right": { "category": "positiveInfinity" }
      },
      "expected": { "outcome": "value", "value": true }
    },
    {
      "id": "value_semantics_004_infinity_opposite_equality_false",
      "description": "Positive infinity and negative infinity are not equal.",
      "operation": "equal",
      "input": {
        "left": { "category": "positiveInfinity" },
        "right": { "category": "negativeInfinity" }
      },
      "expected": { "outcome": "value", "value": false }
    },
    {
      "id": "value_semantics_005_infinity_finite_equality_false",
      "description": "Infinity is not equal to a finite numeric value.",
      "operation": "equal",
      "input": {
        "left": { "category": "positiveInfinity" },
        "right": { "category": "finiteNumber", "value": "999" }
      },
      "expected": { "outcome": "value", "value": false }
    },
    {
      "id": "value_semantics_006_string_equality_exact_true",
      "description": "Strings compare by exact decoded string equality under the active string equality profile.",
      "operation": "equal",
      "input": {
        "left": { "category": "string", "value": "Adapter" },
        "right": { "category": "string", "value": "Adapter" }
      },
      "expected": { "outcome": "value", "value": true }
    },
    {
      "id": "value_semantics_007_boolean_equality_true",
      "description": "Boolean equality is defined within the Boolean category.",
      "operation": "equal",
      "input": {
        "left": { "category": "boolean", "value": true },
        "right": { "category": "boolean", "value": true }
      },
      "expected": { "outcome": "value", "value": true }
    },
    {
      "id": "value_semantics_008_nan_equality_error",
      "description": "NaN is not equality-comparable in the minimum profile.",
      "operation": "equal",
      "input": {
        "left": { "category": "nan" },
        "right": { "category": "nan" }
      },
      "expected": {
        "outcome": "diagnostic",
        "reason": "not_equality_comparable"
      }
    },
    {
      "id": "value_semantics_009_nan_inequality_error",
      "description": "Inequality over NaN also fails closed in the minimum profile.",
      "operation": "notEqual",
      "input": {
        "left": { "category": "nan" },
        "right": { "category": "finiteNumber", "value": "1" }
      },
      "expected": {
        "outcome": "diagnostic",
        "reason": "not_equality_comparable"
      }
    },
    {
      "id": "value_semantics_010_explicit_null_equality_error",
      "description": "Explicit null equality is not defined by the minimum profile.",
      "operation": "equal",
      "input": {
        "left": { "category": "explicitNull", "reason": "none" },
        "right": { "category": "explicitNull", "reason": "none" }
      },
      "expected": {
        "outcome": "diagnostic",
        "reason": "not_equality_comparable"
      }
    },
    {
      "id": "value_semantics_011_mixed_category_equality_error",
      "description": "Mixed categories do not compare by implicit coercion.",
      "operation": "equal",
      "input": {
        "left": { "category": "string", "value": "42" },
        "right": { "category": "finiteNumber", "value": "42" }
      },
      "expected": {
        "outcome": "diagnostic",
        "reason": "mixed_categories"
      }
    },
    {
      "id": "value_semantics_012_finite_number_order_less",
      "description": "Finite numbers order by numeric value.",
      "operation": "compare",
      "input": {
        "left": { "category": "finiteNumber", "value": "2" },
        "right": { "category": "finiteNumber", "value": "10" }
      },
      "expected": { "outcome": "value", "relation": "less" }
    },
    {
      "id": "value_semantics_013_negative_infinity_orders_before_finite",
      "description": "Negative infinity sorts before finite numeric values.",
      "operation": "compare",
      "input": {
        "left": { "category": "negativeInfinity" },
        "right": { "category": "finiteNumber", "value": "0" }
      },
      "expected": { "outcome": "value", "relation": "less" }
    },
    {
      "id": "value_semantics_014_positive_infinity_orders_after_finite",
      "description": "Positive infinity sorts after finite numeric values.",
      "operation": "compare",
      "input": {
        "left": { "category": "positiveInfinity" },
        "right": { "category": "finiteNumber", "value": "0" }
      },
      "expected": { "outcome": "value", "relation": "greater" }
    },
    {
      "id": "value_semantics_015_negative_infinity_orders_before_positive_infinity",
      "description": "Negative infinity sorts before positive infinity.",
      "operation": "compare",
      "input": {
        "left": { "category": "negativeInfinity" },
        "right": { "category": "positiveInfinity" }
      },
      "expected": { "outcome": "value", "relation": "less" }
    },
    {
      "id": "value_semantics_016_equal_infinities_compare_equal",
      "description": "Equal infinities compare equal for ordering.",
      "operation": "compare",
      "input": {
        "left": { "category": "positiveInfinity" },
        "right": { "category": "positiveInfinity" }
      },
      "expected": { "outcome": "value", "relation": "equal" }
    },
    {
      "id": "value_semantics_017_boolean_ordering_error",
      "description": "Boolean ordering is not part of the minimum profile.",
      "operation": "compare",
      "input": {
        "left": { "category": "boolean", "value": false },
        "right": { "category": "boolean", "value": true }
      },
      "expected": {
        "outcome": "diagnostic",
        "reason": "not_orderable"
      }
    },
    {
      "id": "value_semantics_018_nan_ordering_error",
      "description": "NaN is not orderable.",
      "operation": "compare",
      "input": {
        "left": { "category": "nan" },
        "right": { "category": "finiteNumber", "value": "0" }
      },
      "expected": {
        "outcome": "diagnostic",
        "reason": "not_orderable"
      }
    },
    {
      "id": "value_semantics_019_explicit_null_ordering_error",
      "description": "Explicit null ordering is not part of the minimum profile.",
      "operation": "compare",
      "input": {
        "left": { "category": "explicitNull", "reason": "none" },
        "right": { "category": "string", "value": "value" }
      },
      "expected": {
        "outcome": "diagnostic",
        "reason": "not_orderable"
      }
    },
    {
      "id": "value_semantics_020_is_value_finite_number_true",
      "description": "A finite number is a concrete value.",
      "operation": "isValue",
      "input": { "value": { "category": "finiteNumber", "value": "12" } },
      "expected": { "outcome": "value", "value": true }
    },
    {
      "id": "value_semantics_021_is_value_string_true",
      "description": "A string is a concrete value.",
      "operation": "isValue",
      "input": { "value": { "category": "string", "value": "active" } },
      "expected": { "outcome": "value", "value": true }
    },
    {
      "id": "value_semantics_022_is_value_boolean_true",
      "description": "A Boolean is a concrete value.",
      "operation": "isValue",
      "input": { "value": { "category": "boolean", "value": false } },
      "expected": { "outcome": "value", "value": true }
    },
    {
      "id": "value_semantics_023_is_value_missing_false",
      "description": "Missing is an evaluation state, not a concrete value.",
      "operation": "isValue",
      "input": { "value": { "category": "missing" } },
      "expected": { "outcome": "value", "value": false }
    },
    {
      "id": "value_semantics_024_is_value_explicit_null_false",
      "description": "Explicit null is not a concrete value.",
      "operation": "isValue",
      "input": { "value": { "category": "explicitNull", "reason": "notApplicable" } },
      "expected": { "outcome": "value", "value": false }
    },
    {
      "id": "value_semantics_025_is_value_absence_false",
      "description": "An explicit absence value is not a concrete value.",
      "operation": "isValue",
      "input": { "value": { "category": "explicitAbsence", "reason": "missing" } },
      "expected": { "outcome": "value", "value": false }
    },
    {
      "id": "value_semantics_026_is_value_nan_false",
      "description": "NaN is not a concrete value.",
      "operation": "isValue",
      "input": { "value": { "category": "nan" } },
      "expected": { "outcome": "value", "value": false }
    },
    {
      "id": "value_semantics_027_is_value_infinity_true",
      "description": "Infinity is a concrete value.",
      "operation": "isValue",
      "input": { "value": { "category": "positiveInfinity" } },
      "expected": { "outcome": "value", "value": true }
    },
    {
      "id": "value_semantics_028_is_value_container_true",
      "description": "Containers are concrete values.",
      "operation": "isValue",
      "input": { "value": { "category": "container", "containerKind": "object" } },
      "expected": { "outcome": "value", "value": true }
    },
    {
      "id": "value_semantics_029_is_value_binding_set_false",
      "description": "Binding Sets are not concrete values.",
      "operation": "isValue",
      "input": { "value": { "category": "bindingSet", "count": 1 } },
      "expected": { "outcome": "value", "value": false }
    },
    {
      "id": "value_semantics_030_default_profile_codepoint_string_order",
      "description": "The default value-semantics profile uses portable codepoint string ordering.",
      "operation": "compare",
      "input": {
        "profile": "aeon.value.default.v1",
        "left": { "category": "string", "value": "éclair" },
        "right": { "category": "string", "value": "zebre" }
      },
      "expected": { "outcome": "value", "relation": "greater" }
    },
    {
      "id": "value_semantics_031_explicit_codepoint_string_order",
      "description": "The explicit codepoint string profile orders decoded Unicode scalar values from left to right.",
      "operation": "compare",
      "input": {
        "profile": "aeon.value.string.codepoint.v1",
        "left": { "category": "string", "value": "éclair" },
        "right": { "category": "string", "value": "zebre" }
      },
      "expected": { "outcome": "value", "relation": "greater" }
    },
    {
      "id": "value_semantics_032_same_family_temporal_order",
      "description": "Same-family temporal values order by canonical temporal payload in the minimum profile.",
      "operation": "compare",
      "input": {
        "left": { "category": "temporal", "semanticType": "date", "value": "2026-07-25" },
        "right": { "category": "temporal", "semanticType": "date", "value": "2025-01-01" }
      },
      "expected": { "outcome": "value", "relation": "greater" }
    },
    {
      "id": "value_semantics_033_same_family_temporal_equality",
      "description": "Same-family temporal equality compares canonical temporal payload identity.",
      "operation": "equal",
      "input": {
        "left": { "category": "temporal", "semanticType": "date", "value": "2026-07-25" },
        "right": { "category": "temporal", "semanticType": "date", "value": "2026-07-25" }
      },
      "expected": { "outcome": "value", "value": true }
    },
    {
      "id": "value_semantics_034_cross_family_temporal_order_error",
      "description": "Different temporal families do not compare by implicit coercion.",
      "operation": "compare",
      "input": {
        "left": { "category": "temporal", "semanticType": "datetime", "value": "2026-07-25T09:30:00Z" },
        "right": { "category": "temporal", "semanticType": "date", "value": "2026-07-25" }
      },
      "expected": { "outcome": "diagnostic", "reason": "mixed_categories" }
    },
    {
      "id": "value_semantics_035_toggle_token_identity_false",
      "description": "Different toggle spellings are not collapsed to Boolean-like aliases.",
      "operation": "equal",
      "input": {
        "left": { "category": "toggle", "value": "yes" },
        "right": { "category": "toggle", "value": "on" }
      },
      "expected": { "outcome": "value", "value": false }
    },
    {
      "id": "value_semantics_036_toggle_boolean_equality_error",
      "description": "Toggle and Boolean values do not compare by implicit coercion.",
      "operation": "equal",
      "input": {
        "left": { "category": "toggle", "value": "yes" },
        "right": { "category": "boolean", "value": true }
      },
      "expected": { "outcome": "diagnostic", "reason": "mixed_categories" }
    },
    {
      "id": "value_semantics_037_hex_identity_true",
      "description": "Hex values compare by canonical hex-payload identity.",
      "operation": "equal",
      "input": {
        "left": { "category": "hex", "value": "ff00aa" },
        "right": { "category": "hex", "value": "ff00aa" }
      },
      "expected": { "outcome": "value", "value": true }
    },
    {
      "id": "value_semantics_038_hex_radix_equality_error",
      "description": "Hex and radix values do not compare by implicit base-16 coercion.",
      "operation": "equal",
      "input": {
        "left": { "category": "hex", "value": "10" },
        "right": { "category": "radix", "semanticType": "radix[16]", "value": "10" }
      },
      "expected": { "outcome": "diagnostic", "reason": "mixed_categories" }
    },
    {
      "id": "value_semantics_039_radix_metadata_identity_true",
      "description": "Radix equality preserves radix-family metadata as part of identity.",
      "operation": "equal",
      "input": {
        "left": { "category": "radix", "semanticType": "radix[16]", "value": "10" },
        "right": { "category": "radix", "semanticType": "radix[16]", "value": "10" }
      },
      "expected": { "outcome": "value", "value": true }
    },
    {
      "id": "value_semantics_040_radix_metadata_identity_false",
      "description": "Radix payload equality does not erase radix-family metadata.",
      "operation": "equal",
      "input": {
        "left": { "category": "radix", "semanticType": "radix[16]", "value": "10" },
        "right": { "category": "radix", "semanticType": "radix8", "value": "10" }
      },
      "expected": { "outcome": "value", "value": false }
    },
    {
      "id": "value_semantics_041_encoding_naive_payload_order",
      "description": "Encoding ordering uses deterministic preserved payload order, not decoded byte or text order.",
      "operation": "compare",
      "input": {
        "left": { "category": "encoding", "value": "A" },
        "right": { "category": "encoding", "value": "B" }
      },
      "expected": { "outcome": "value", "relation": "less" }
    },
    {
      "id": "value_semantics_042_separator_naive_payload_order",
      "description": "Separator ordering compares whole payloads and does not infer version or segment order.",
      "operation": "compare",
      "input": {
        "left": { "category": "separator", "value": "0.11.0" },
        "right": { "category": "separator", "value": "0.9.9" }
      },
      "expected": { "outcome": "value", "relation": "less" }
    },
    {
      "id": "value_semantics_043_sansa_address_identity_true",
      "description": "SANSA address values compare by canonical address-expression identity.",
      "operation": "equal",
      "input": {
        "left": { "category": "sansaAddress", "value": "$.inventory.items.*.sku" },
        "right": { "category": "sansaAddress", "value": "$.inventory.items.*.sku" }
      },
      "expected": { "outcome": "value", "value": true }
    },
    {
      "id": "value_semantics_044_reference_form_identity_true",
      "description": "Reference forms compare by reference-form identity and do not implicitly follow targets.",
      "operation": "equal",
      "input": {
        "left": { "category": "referenceForm", "value": { "kind": "clone", "target": "$.target" } },
        "right": { "category": "referenceForm", "value": { "target": "$.target", "kind": "clone" } }
      },
      "expected": { "outcome": "value", "value": true }
    },
    {
      "id": "value_semantics_045_reference_form_kind_identity_false",
      "description": "Clone and pointer reference forms do not compare equal just because their target path matches.",
      "operation": "equal",
      "input": {
        "left": { "category": "referenceForm", "value": { "kind": "clone", "target": "$.target" } },
        "right": { "category": "referenceForm", "value": { "kind": "pointer", "target": "$.target" } }
      },
      "expected": { "outcome": "value", "value": false }
    },
    {
      "id": "value_semantics_046_default_string_order_is_not_natural_ascii",
      "description": "The default string profile does not perform numeric-region natural sorting.",
      "operation": "compare",
      "input": {
        "profile": "aeon.value.default.v1",
        "left": { "category": "string", "value": "part-2" },
        "right": { "category": "string", "value": "part-10" }
      },
      "expected": { "outcome": "value", "relation": "greater" }
    },
    {
      "id": "value_semantics_047_natural_ascii_string_order",
      "description": "The explicit Natural ASCII profile compares ASCII digit runs numerically.",
      "operation": "compare",
      "input": {
        "profile": "aeon.value.string.natural.ascii.v1",
        "left": { "category": "string", "value": "part-2" },
        "right": { "category": "string", "value": "part-10" }
      },
      "expected": { "outcome": "value", "relation": "less" }
    }
  ]
}

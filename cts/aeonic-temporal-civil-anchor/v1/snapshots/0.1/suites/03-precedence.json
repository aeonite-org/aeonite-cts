    {
      "id": "month-anchor",
      "fixture": {
        "request": {
          "operation": "anchor",
          "input": {
            "anchor": {
              "temporal": {
                "category": "civilDate",
                "value": "2024-02"
              }
            },
            "clock": {
              "temporal": {
                "category": "civilClock",
                "value": "09:30:00"
              }
            },
            "context": {
              "profile": "aeonic.operations.temporal.civil-anchor.v1"
            }

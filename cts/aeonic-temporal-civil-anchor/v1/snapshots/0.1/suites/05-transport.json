{
  "id": "05-transport",
  "tests": [
    {
      "id": "raw-negative-zero-width",
      "fixture": {
        "requestText": "{\"operation\":\"anchor\",\"input\":{\"anchor\":{\"temporal\":{\"category\":\"container\",\"opaque\":{\"arbitrary\":-0}}},\"clock\":{\"temporal\":{\"category\":\"civilClock\",\"value\":\"09:30:00\"}},\"context\":{\"profile\":\"aeonic.operations.temporal.civil-anchor.v1\"}}}"
      },
      "expected": {
        "outcome": "diagnostic",
        "reason": "resource_limit",
        "context": {
          "stage": 1,
          "path": null
        }
      },
      "policy": {
        "resourceLimits": {
          "maxRequestBytes": 237
        }
      }
    },
    {
      "id": "duplicate-operation",
      "fixture": {
        "requestText": "{\"operation\":\"anchor\",\"operation\":\"anchor\",\"input\":{}}"
      },
      "expected": {
        "outcome": "diagnostic",
        "reason": "invalid_operand",
        "context": {
          "stage": 2,
          "path": null
        }
      }
    },
    {
      "id": "verbatim-whitespace-at-limit",
      "fixture": {
        "requestText": " {\"operation\":\"anchor\",\"input\":{\"anchor\":{\"temporal\":{\"category\":\"civilDate\",\"value\":\"2024-02-28\"}},\"clock\":{\"temporal\":{\"category\":\"civilClock\",\"value\":\"09:30:00\"}},\"context\":{\"profile\":\"aeonic.operations.temporal.civil-anchor.v1\"}}} "
      },
      "expected": {
        "outcome": "value",
        "value": {
          "temporal": {
            "category": "civilDateTimeSet",
            "pieces": [
              {
                "kind": "point",
                "at": "2024-02-28T09:30:00"
              }
            ]
          },
          "originDateGranularity": "day",
          "originClockForm": "second",
          "history": {
            "clamping": "none-declared",
            "approximation": "none-declared"
          }
        },
        "metadata": {
          "evaluation": "exact-for-policy",
          "clamping": "not-applied",
          "effectivePolicy": {
            "profile": "aeonic.operations.temporal.civil-anchor.v1"
          }
        }
      },
      "policy": {
        "resourceLimits": {
          "maxRequestBytes": 235
        }
      }
    },

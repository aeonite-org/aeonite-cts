{
  "meta": {
    "suite_id": "stable-identity-order-target",
    "lane": "stable-identity-order-target",
    "capability": "ASP.Target.StableIdentityOrder",
    "profile": "asp.stable-identity-order.profile.v1",
    "sut_protocol": "cts.protocol.v1",
    "owner": "target-adapter",
    "description": "Authorization, final validation, bounded insert recompilation, immutable reorder intent, and durable idempotency."
  },
  "id": "stable-identity-order-target",
  "title": "Stable Identity/Order Target Adapter",
  "tests": [
    {
      "id": "stable-order-target-001-guard-sequencing",
      "tags": ["experimental", "authorization", "aeos", "reorder"],
      "input": { "action": "guarded_reorder" },
      "expected": {
        "ok": true,
        "outcome": "committed",
        "phases": ["request", "resolved-plan", "commit", "validate"],
        "documentRevision": 6,
        "childStructuralIds": ["I1", "I0"]
      }
    },
    {
      "id": "stable-order-target-002-bounded-insert-recompile",
      "tags": ["experimental", "retry", "insert", "race"],
      "input": { "action": "bounded_insert_retry" },
      "expected": {
        "ok": true,
        "outcome": "committed",
        "attempts": [
          { "index": 1, "txId": "tx:cts-insert", "outcome": "stale_recompilable", "phase": "commit" },
          { "index": 2, "txId": "tx:cts-insert", "outcome": "committed", "phase": "commit" }
        ],
        "requestAuthorizations": 2,
        "planPhases": ["resolved-plan", "resolved-plan", "commit"],
        "childStructuralIds": ["I1", "I0", "N"]
      }
    },
    {
      "id": "stable-order-target-003-reorder-is-not-rewritten",
      "tags": ["experimental", "retry", "reorder", "negative"],
      "input": { "action": "stale_reorder" },
      "expected": {
        "ok": false,
        "outcome": "semantic_conflict",
        "attemptCount": 1,
        "errorCodes": [
          "SET_ORDER_REVISION_STALE",
          "ORDER_PRECONDITION_STALE",
          "SET_ORDER_PRECONDITION_FINGERPRINT_MISMATCH"
        ]
      }
    },
    {
      "id": "stable-order-target-004-idempotent-retry",
      "tags": ["experimental", "idempotency", "insert"],
      "input": { "action": "idempotent_insert" },
      "expected": {
        "firstOutcome": "committed",
        "retryOutcome": "already_satisfied",
        "retryPlanAuthorizations": 0,
        "collisionOutcome": "semantic_conflict",
        "collisionErrorCodes": ["ORDERED_CHILD_INSERT_TX_ID_COLLISION"]
      }
    },
    {
      "id": "stable-order-target-005-ordered-children-batch",
      "tags": ["experimental", "batch", "authorization", "aeos", "durability"],
      "input": { "action": "ordered_children_batch" },
      "expected": {
        "ok": true,
        "outcome": "committed",
        "phases": ["request", "resolved-plan", "commit", "validate"],
        "documentRevision": 6,
        "materialRevision": 1,
        "nextMaterialIndex": 4,
        "childStructuralIds": ["N", "I0", "I1", "M"]
      }
    },
    {
      "id": "stable-order-target-006-ordered-children-mutation",
      "tags": ["experimental", "mixed-batch", "authorization", "aeos", "durability"],
      "input": { "action": "ordered_children_mutation" },
      "expected": {
        "ok": true,
        "outcome": "committed",
        "phases": ["request", "resolved-plan", "commit", "validate"],
        "documentRevision": 6,
        "materialRevision": 1,
        "nextMaterialIndex": 3,
        "childStructuralIds": ["N", "I1", "I0"]
      }
    }
  ]
}
